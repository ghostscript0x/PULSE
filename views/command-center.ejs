<div class="container" style="padding-top: 1.5rem; padding-left: 1rem; padding-right: 1rem;">
    <!-- WELCOME HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 1.5rem;">
        <div class="section-label" data-aos="fade-right" style="font-size: 0.7rem; margin-bottom: 0.5rem;">Access Granted</div>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: clamp(1.75rem, 6vw, 3.5rem); line-height: 1.1;">COMMAND CENTER<span class="text-cyan">.</span></h1>
                <p class="text-soft" style="margin-top: 0.5rem; font-size: 0.85rem;">Welcome to Pulse. You're now connected to the Zero Authority network.</p>
            </div>
            <div class="mono text-cyan" style="font-size: 0.6rem; border: 1px solid var(--glass-border); padding: 0.5rem 0.75rem; border-radius: 4px; text-align: center;">
                OPERATOR: <%= user.username %>
            </div>
        </div>
    </section>
    <style>
        @media (min-width: 768px) {
            .page-header > div {
                flex-direction: row !important;
                justify-content: space-between !important;
                align-items: flex-end !important;
            }
            .page-header .mono.text-cyan {
                text-align: left !important;
                font-size: 0.7rem !important;
                padding: 0.5rem 1rem !important;
            }
        }
    </style>

    <!-- Main grid - stacked on mobile -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- TRACKED NODES -->
        <div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; align-items: flex-start;">
                <span class="section-label" style="margin: 0;">Tracked Nodes</span>
                <span class="mono text-muted" style="font-size: 0.55rem;"><%= followedDaos.length %> ACTIVE</span>
            </div>

            <% if (followedDaos.length === 0) { %>
                <div class="glass-panel" style="padding: 2rem 1rem; text-align: center; border-style: dashed;">
                    <p class="text-soft" style="font-size: 0.85rem;">No active telemetry links. Select a community from the registry below.</p>
                </div>
            <% } else { %>
                <div style="display: grid; grid-template-columns: 1fr; gap: 0.75rem;">
                    <% followedDaos.forEach(dao => { %>
                        <div class="feature-card" style="padding: 1rem;">
                            <h3 style="font-size: 1rem; margin-bottom: 0.5rem;"><%= dao.name %></h3>
                            <p class="text-muted mono" style="font-size: 0.5rem; margin-bottom: 1rem; word-break: break-all;">UUID: <%= dao.daoId %></p>

                            <div style="display: flex; gap: 0.5rem; flex-direction: column;">
                                <a href="/intelligence/<%= dao.daoId %>" class="btn-cyan-solid" style="flex: 1; font-size: 0.7rem; padding: 0.6rem; text-align: center;">MONITOR</a>
                                <form action="/unfollow-dao" method="POST" style="margin: 0; flex: 1;">
                                    <input type="hidden" name="daoId" value="<%= dao.daoId %>">
                                    <button type="submit" class="btn-cyan-solid" style="width: 100%; font-size: 0.7rem; padding: 0.6rem; background: transparent; border: 1px solid rgba(255,59,59,0.2); color: #ff3b3b;">KILL</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
        <style>
            @media (min-width: 480px) {
                .feature-card ~ div {
                    grid-template-columns: repeat(2, 1fr) !important;
                }
            }
            @media (min-width: 768px) {
                .feature-card ~ div {
                    grid-template-columns: repeat(2, 1fr) !important;
                    gap: 1.5rem !important;
                }
                .feature-card ~ div > * {
                    padding: 1.5rem !important;
                }
                .feature-card ~ div > * > div:first-child {
                    flex-direction: row !important;
                }
                .feature-card ~ div > * h3 {
                    font-size: 1.1rem !important;
                }
                .feature-card ~ div > * p {
                    font-size: 0.55rem !important;
                    margin-bottom: 1.5rem !important;
                }
            }
        </style>

        <!-- NODE REGISTRY -->
        <aside>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="section-label" style="margin: 0;">Node Registry</span>
                <div class="pulse-dot"></div>
            </div>

            <div id="discovery-list" style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div class="text-soft mono" style="font-size: 0.6rem; text-align: center; padding: 1.5rem;">SCANNING_NETWORK...</div>
            </div>
        </aside>
    </div>

<script>
    fetch('/api/discovery')
        .then(res => res.json())
        .then(res => {
            const list = document.getElementById('discovery-list');
            const data = res.data;
            const orgs = Array.isArray(data) ? data : (data && data.organizations ? data.organizations : []);
            
            if (res.status === 'success' && orgs.length > 0) {
                list.innerHTML = orgs.map(org => `
                    <div class="glass-panel" style="padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; border-color: rgba(255,255,255,0.05);">
                        <div style="flex: 1;">
                            <div class="text-white mono" style="font-size: 0.75rem; font-weight: 700;">${org.name || 'UNKNOWN_NODE'}</div>
                            <div class="text-muted mono" style="font-size: 0.5rem; margin-top: 0.2rem; word-break: break-all;">${org.id}</div>
                        </div>
                        <form action="/follow-dao" method="POST" style="margin: 0;">
                            <input type="hidden" name="daoId" value="${org.id}">
                            <input type="hidden" name="name" value="${org.name}">
                            <button type="submit" class="btn-cyan-solid" style="padding: 0.4rem 1rem; font-size: 0.65rem; width: 100%;">FOLLOW</button>
                        </form>
                    </div>
                `).join('');
            } else {
                list.innerHTML = '<div class="text-soft mono" style="text-align: center; padding: 2rem;">NO_NODES_FOUND</div>';
            }
        });
</script>
<style>
    @media (min-width: 768px) {
        aside > div.glass-panel {
            flex-direction: row !important;
            align-items: center !important;
            padding: 1.5rem !important;
        }
        aside .btn-cyan-solid {
            width: auto !important;
        }
    }
</style>
