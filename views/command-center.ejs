<div class="container" style="padding-top: 4rem;">
    <!-- WELCOME HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 4rem;">
        <div class="section-label" data-aos="fade-right">Access Granted</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: 3.5rem; line-height: 1;">COMMAND CENTER<span class="text-cyan">.</span></h1>
                <p class="text-soft" style="margin-top: 1rem;">Welcome to Pulse. You're now connected to the Zero Authority network.</p>
            </div>
            <div class="mono text-cyan" style="font-size: 0.7rem; border: 1px solid var(--glass-border); padding: 0.5rem 1rem; border-radius: 4px;">
                OPERATOR: <%= user.username %>
            </div>
        </div>
    </section>

    <div class="responsive-grid" style="grid-template-columns: 1fr; gap: 2rem;">
        <!-- TRACKED NODES -->
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <span class="section-label" style="margin: 0;">Tracked Nodes</span>
                <span class="mono text-muted" style="font-size: 0.6rem;"><%= followedDaos.length %> ACTIVE</span>
            </div>

            <% if (followedDaos.length === 0) { %>
                <div class="glass-panel" style="padding: 4rem 1.5rem; text-align: center; border-style: dashed;">
                    <p class="text-soft" style="font-size: 0.9rem;">No active telemetry links. Select a community from the registry below.</p>
                </div>
            <% } else { %>
                <div class="responsive-grid responsive-grid-2">
                    <% followedDaos.forEach(dao => { %>
                        <div class="feature-card" style="padding: 1.5rem;">
                            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;"><%= dao.name %></h3>
                            <p class="text-muted mono" style="font-size: 0.55rem; margin-bottom: 1.5rem; word-break: break-all;">UUID: <%= dao.daoId %></p>

                            <div style="display: flex; gap: 0.75rem;">
                                <a href="/intelligence/<%= dao.daoId %>" class="btn-cyan-solid" style="flex: 1; font-size: 0.7rem; padding: 0.6rem;">MONITOR</a>
                                <form action="/unfollow-dao" method="POST" style="margin: 0; flex: 1;">
                                    <input type="hidden" name="daoId" value="<%= dao.daoId %>">
                                    <button type="submit" class="btn-cyan-solid" style="width: 100%; font-size: 0.7rem; padding: 0.6rem; background: transparent; border: 1px solid rgba(255,59,59,0.2); color: #ff3b3b;">KILL</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- NODE REGISTRY -->
        <aside>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <span class="section-label" style="margin: 0;">Node Registry</span>
                <div class="pulse-dot"></div>
            </div>

            <div id="discovery-list" style="display: flex; flex-direction: column; gap: 1rem;">
                <div class="text-soft mono" style="font-size: 0.6rem; text-align: center; padding: 2rem;">SCANNING_NETWORK...</div>
            </div>
        </aside>
    </div></div>

<script>
    fetch('/api/discovery')
        .then(res => res.json())
        .then(res => {
            const list = document.getElementById('discovery-list');
            const data = res.data;
            const orgs = Array.isArray(data) ? data : (data && data.organizations ? data.organizations : []);
            
            if (res.status === 'success' && orgs.length > 0) {
                list.innerHTML = orgs.map(org => `
                    <div class="glass-panel" style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; border-color: rgba(255,255,255,0.05);">
                        <div style="flex: 1;">
                            <div class="text-white mono" style="font-size: 0.75rem; font-weight: 700;">${org.name || 'UNKNOWN_NODE'}</div>
                            <div class="text-muted mono" style="font-size: 0.55rem; margin-top: 0.2rem;">${org.id}</div>
                        </div>
                        <form action="/follow-dao" method="POST" style="margin: 0;">
                            <input type="hidden" name="daoId" value="${org.id}">
                            <input type="hidden" name="name" value="${org.name}">
                            <button type="submit" class="btn-cyan-solid" style="padding: 0.4rem 1rem; font-size: 0.65rem; min-height: auto;">FOLLOW</button>
                        </form>
                    </div>
                `).join('');
            } else {
                list.innerHTML = '<div class="text-soft mono" style="text-align: center; padding: 2rem;">NO_NODES_FOUND</div>';
            }
        });
</script>
