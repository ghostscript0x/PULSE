<section style="margin-bottom: 4rem;">
    <div class="mono text-cyan" style="font-size: 0.7rem; margin-bottom: 1.5rem;">[ACCESS_GRANTED]</div>
    <h1 style="letter-spacing: 10px; margin-bottom: 1rem;">COMMAND_CENTER</h1>
    <p class="text-soft glow-text" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px;">Managing active telemetry links for user: <span class="text-cyan"><%= user.username %></span></p>
</section>

<div class="grid-dashboard" style="grid-template-columns: 1fr 400px; grid-template-areas: 'followed discovery';">
    <!-- FOLLOWED DAOS -->
    <section style="grid-area: followed;">
        <h2 style="border-bottom: 1px solid var(--glass-border); padding-bottom: 1rem; margin-bottom: 2rem; font-size: 1.2rem;">TRACKED_NODES</h2>
        
        <% if (followedDaos.length === 0) { %>
            <div class="glass-panel" style="text-align: center; padding: 4rem; border-style: dashed;">
                <p class="text-soft mono" style="font-size: 0.8rem;">NO_ACTIVE_TELEMETRY_LINKS_FOUND</p>
                <p class="text-soft" style="font-size: 0.7rem; margin-top: 1rem;">Select a node from the registry to begin monitoring.</p>
            </div>
        <% } else { %>
            <div class="grid-2">
                <% followedDaos.forEach(dao => { %>
                    <div class="glass-panel" style="display: flex; justify-content: space-between; align-items: center; border-left: 2px solid var(--signal-cyan);">
                        <div>
                            <h3 style="font-size: 1rem; margin: 0;"><%= dao.name %></h3>
                            <div class="mono text-soft" style="font-size: 0.5rem; opacity: 0.5; margin-top: 0.4rem;">UUID: <%= dao.daoId %></div>
                        </div>
                        <div style="display: flex; gap: 1rem;">
                            <a href="/dashboard/<%= dao.daoId %>" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.6rem;">MONITOR</a>
                            <form action="/unfollow-dao" method="POST" style="margin: 0;">
                                <input type="hidden" name="daoId" value="<%= dao.daoId %>">
                                <button type="submit" class="btn" style="background: rgba(255,59,59,0.1); color: var(--status-critical); border: 1px solid rgba(255,59,59,0.2); padding: 0.4rem 1rem; font-size: 0.6rem;">TERMINATE</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>

    <!-- DISCOVERY REGISTRY -->
    <section style="grid-area: discovery;">
        <h2 style="border-bottom: 1px solid var(--glass-border); padding-bottom: 1rem; margin-bottom: 2rem; font-size: 1.2rem;">NODE_REGISTRY</h2>
        <div id="discovery-list" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="text-soft mono" style="font-size: 0.6rem; text-align: center;">SCANNING_NETWORK...</div>
        </div>
    </section>
</div>

<script>
    fetch('/api/discovery')
        .then(res => res.json())
        .then(res => {
            const list = document.getElementById('discovery-list');
            if (res.status === 'success' && res.data) {
                list.innerHTML = res.data.map(org => `
                    <div class="glass-panel" style="padding: 1rem; display: flex; justify-content: space-between; align-items: center; border-color: rgba(255,255,255,0.05);">
                        <div style="flex: 1;">
                            <div class="text-soft mono" style="font-size: 0.7rem; font-weight: 700;">${org.name || 'UNKNOWN_NODE'}</div>
                            <div class="text-soft mono" style="font-size: 0.5rem; opacity: 0.3;">${org.id}</div>
                        </div>
                        <form action="/follow-dao" method="POST" style="margin: 0;">
                            <input type="hidden" name="daoId" value="${org.id}">
                            <input type="hidden" name="name" value="${org.name}">
                            <button type="submit" class="btn btn-primary" style="padding: 0.3rem 0.8rem; font-size: 0.6rem;">FOLLOW</button>
                        </form>
                    </div>
                `).join('');
            }
        });
</script>
