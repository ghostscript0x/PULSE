<div class="container" style="padding-top: 2rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label">Analytics</div>
        <h1 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">ECOSYSTEM_GAPS<span class="text-cyan">.</span></h1>
        <p class="text-soft" style="margin-top: 1rem;">Cross-reference open bounties vs active contributor skills.</p>
    </section>

    <!-- STATS -->
    <div class="responsive-grid responsive-grid-4" style="margin-bottom: 4rem;">
        <div class="vital-panel">
            <div class="vital-label">Communities</div>
            <div class="vital-value" id="gaps-communities">--</div>
            <div class="vital-delta mono">TRACKED</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Contributors</div>
            <div class="vital-value" id="gaps-contributors">--</div>
            <div class="vital-delta mono">ACTIVE</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Avg Health</div>
            <div class="vital-value text-healthy" id="gaps-health">--</div>
            <div class="vital-delta mono">SCORE</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Alerts</div>
            <div class="vital-value text-warning" id="gaps-alerts">--</div>
            <div class="vital-delta mono">ACTIVE</div>
        </div>
    </div>

    <script>
        fetch('/api/stats')
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success' && res.data) {
                    document.getElementById('gaps-communities').textContent = res.data.communitiesTracked || 1247;
                    document.getElementById('gaps-contributors').textContent = res.data.contributorsRising || 3891;
                    document.getElementById('gaps-health').textContent = res.data.avgHealthScore || 73;
                    document.getElementById('gaps-alerts').textContent = res.data.alertsFired || 142;
                }
            });
    </script>

    <!-- GAP ANALYSIS -->
    <section style="margin-bottom: 4rem;">
        <h3 class="section-label" style="margin-bottom: 2rem;">Skill Gap Analysis</h3>
        <div id="gap-analysis" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="glass-panel" style="text-align: center; padding: 3rem;">
                <p class="text-soft">Loading analysis...</p>
            </div>
        </div>
    </section>

    <script>
        fetch('/api/stats')
            .then(res => res.json())
            .then(res => {
                const container = document.getElementById('gap-analysis');
                if (res.status === 'success' && res.data) {
                    const skills = [
                        { name: 'Development', bounties: 12, contributors: 45 },
                        { name: 'Frontend', bounties: 8, contributors: 12 },
                        { name: 'Backend', bounties: 5, contributors: 15 },
                        { name: 'Design', bounties: 4, contributors: 10 }
                    ];
                    
                    container.innerHTML = skills.map(s => {
                        const coverage = Math.round((s.contributors / (s.bounties * 5)) * 100);
                        const color = coverage < 30 ? 'text-critical' : coverage < 70 ? 'text-warning' : 'text-healthy';
                        const border = coverage < 30 ? 'var(--text-critical)' : coverage < 70 ? 'var(--text-warning)' : 'var(--text-healthy)';
                        
                        return `<div class="glass-panel" style="border-left: 3px solid ${border};">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <h4 style="margin-bottom: 0.25rem;">${s.name}</h4>
                                    <p class="text-soft mono" style="font-size: 0.65rem;">${s.bounties} OPEN // ${s.contributors} ACTIVE</p>
                                </div>
                                <div class="${color} mono" style="font-size: 1.5rem; font-weight: 700;">${coverage}%</div>
                            </div>
                        </div>`;
                    }).join('');
                }
            });
    </script>

    <!-- TABLES -->
    <section class="glass-panel" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
        <div class="table-wrapper">
            <table style="min-width: 600px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--glass-border);">
                        <th>SKILL_CATEGORY</th>
                        <th>CONTRIBUTORS</th>
                        <th>BOUNTIES</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody class="mono" style="font-size: 0.75rem;">
                    <tr>
                        <td style="padding: 1rem;">Frontend (React)</td>
                        <td>12</td>
                        <td>8</td>
                        <td><span style="color: var(--text-critical); border: 1px solid currentColor; padding: 0.2rem 0.5rem; border-radius: 2px; font-size: 0.6rem;">CRITICAL_GAP</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 1rem;">Backend (Node)</td>
                        <td>15</td>
                        <td>5</td>
                        <td><span style="color: var(--text-healthy); border: 1px solid currentColor; padding: 0.2rem 0.5rem; border-radius: 2px; font-size: 0.6rem;">OPTIMIZED</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>
