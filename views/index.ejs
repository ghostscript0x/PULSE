        <div class="mock-browser" data-aos="zoom-in-up" data-aos-delay="600">
            <div class="browser-header">
                <div class="dot-group">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
                <div class="browser-url">app.pulseweb3.xyz/intelligence</div>
            </div>
            <div class="mock-content">
                <div class="mock-sidebar">
                    <div class="sidebar-item" style="width: 100%; height: 20px; background: var(--accent-cyan); opacity: 0.2; margin-bottom: 3rem;"></div>
                    <div class="sidebar-item"></div>
                    <div class="sidebar-item"></div>
                    <div class="sidebar-item"></div>
                    <div class="sidebar-item"></div>
                </div>
                <div class="mock-main">
                    <div class="mock-grid">
                        <div class="mock-card" data-aos="fade-up" data-aos-delay="800"><div class="card-title">Health</div><div class="card-val text-healthy">78</div></div>
                        <div class="mock-card" data-aos="fade-up" data-aos-delay="900"><div class="card-title">Active</div><div class="card-val">412</div></div>
                        <div class="mock-card" data-aos="fade-up" data-aos-delay="1000"><div class="card-title">Completion</div><div class="card-val">92%</div></div>
                        <div class="mock-card" data-aos="fade-up" data-aos-delay="1100"><div class="card-title">Risk</div><div class="card-val text-risk-low">Low</div></div>
                    </div>
                    <div class="mock-chart" data-aos="fade-up" data-aos-delay="1200">
                        <div class="card-title">Health Trend (30D)</div>
                        <svg viewBox="0 0 800 200" style="width: 100%; height: 120px; margin-top: 1rem;">
                            <path d="M0,150 Q100,140 200,100 T400,80 T600,120 T800,40" fill="none" stroke="var(--accent-cyan)" stroke-width="3" />
                            <path d="M0,150 Q100,140 200,100 T400,80 T600,120 T800,40 L800,200 L0,200 Z" fill="url(#chartGrad)" opacity="0.1" />
                            <defs>
                                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="var(--accent-cyan)" />
                                    <stop offset="100%" stop-color="transparent" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="mock-card" style="margin-top: 2rem; border-left: 2px solid var(--accent-cyan);" data-aos="fade-up" data-aos-delay="1400">
                        <div class="card-title">AI Insight</div>
                        <p class="mono" style="font-size: 0.8rem; color: var(--text-soft);">Contributor velocity in 'Development' pod has increased by 14%. Recommend increasing bounty liquidity for Q3 goals.</p>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top: 4rem;" data-aos="fade-up">
            <% if (user) { %>
                <a href="/intelligence" class="btn-cyan-solid">Access Full Intelligence Layer</a>
            <% } else { %>
