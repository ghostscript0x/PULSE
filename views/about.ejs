<div class="container" style="padding-top: 2rem;">
    <div class="hero-aura-enhanced"></div>
    <!-- ABOUT HERO -->
    <section class="hero">
        <div class="badge-pill premium-card pulse-ring" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); padding: 0.5rem 1rem; border-radius: 100px; font-size: 0.7rem; margin-bottom: 2rem;">
            <span class="pulse-dot"></span>
            PROTOCOL_DOCUMENTATION_V3.3
        </div>
        <h1 style="font-weight: 800; line-height: 1.1;">
            SYSTEM<br>
            <span class="text-gradient">PROTOCOL.</span>
        </h1>
        <p class="text-soft" style="max-width: 600px; margin: 0 auto 3rem; font-size: 1.1rem;">
            PULSE is a high-fidelity intelligence operating system designed to monitor the vital signs of decentralized organizations.
        </p>
    </section>

    <!-- OPERATIONAL FLOW -->
    <section style="margin-bottom: 4rem;">
        <div style="text-align: left; margin-bottom: 3rem;">
            <span class="section-label">Operational Flow</span>
            <h2 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">How Pulse reads the <span class="text-gradient">void.</span></h2>
        </div>
        
        <div class="responsive-grid responsive-grid-3">
            <div class="feature-card premium-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1.5rem;">[01]</div>
                <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Target Identification</h3>
                <p class="text-soft" style="font-size: 0.9rem;">Every node on the network is identified by a cryptographic UUID. Pulse targets these nodes to initialize telemetry.</p>
                <div class="feature-tag" style="margin-top: 1.5rem;">UUID_MAPPING</div>
            </div>
            <div class="feature-card premium-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1.5rem;">[02]</div>
                <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Telemetry Sync</h3>
                <p class="text-soft" style="font-size: 0.9rem;">Establish a real-time fetch-and-compute cycle. Pulse synchronizes with live production data directly from the network core.</p>
                <div class="feature-tag" style="margin-top: 1.5rem;">FETCH_SYNC</div>
            </div>
            <div class="feature-card premium-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1.5rem;">[03]</div>
                <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Vitality Analysis</h3>
                <p class="text-soft" style="font-size: 0.9rem;">Pulse computes a deterministic health score based on weighted vitality vectors derived from raw activity logs.</p>
                <div class="feature-tag" style="margin-top: 1.5rem;">COMPUTE_ENGINE</div>
            </div>
        </div>
    </section>

    <!-- CORE MODULES -->
    <section class="glass-panel premium-card gradient-border" style="margin-bottom: 4rem; padding: 3rem 2rem;">
        <div style="text-align: center; margin-bottom: 4rem;">
            <span class="section-label">Core Modules</span>
            <h2 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">Intelligence <span class="text-gradient">Infrastructure.</span></h2>
        </div>

        <div class="responsive-grid responsive-grid-2">
            <div class="feature-card">
                <div class="text-cyan mono" style="font-size: 0.7rem; margin-bottom: 1rem;">MODULE_01</div>
                <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Deterministic Health Engine</h3>
                <p class="text-soft" style="font-size: 0.9rem;">The heart of PULSE. It aggregates raw bounty and contributor data to calculate a normalized health score.</p>
            </div>
            <div class="feature-card">
                <div class="text-warning mono" style="font-size: 0.7rem; margin-bottom: 1rem;">MODULE_02</div>
                <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Neural Insights</h3>
                <p class="text-soft" style="font-size: 0.9rem;">Powered by Groq inference. Performs qualitative analysis to detect contributor burnout patterns.</p>
            </div>
        </div>
    </section>

    <!-- VITALITY ALGORITHM -->
    <section style="margin-bottom: 6rem;">
        <div class="responsive-grid responsive-grid-2" style="align-items: center;">
            <div>
                <span class="section-label">Algorithm</span>
                <h2 style="font-family: var(--font-display); font-size: 2.5rem; margin-bottom: 1.5rem;">VITALITY_V1.</h2>
                <p class="text-soft" style="margin-bottom: 2rem;">The algorithm prioritizes <strong>Velocity</strong> and <strong>Completion</strong> as the primary indicators of community health.</p>
                <div class="glass-panel" style="padding: 1.5rem; border-left: 2px solid var(--accent-cyan);">
                    <p class="text-soft" style="font-size: 0.85rem;">High treasury with low production signals "at-risk" status.</p>
                </div>
            </div>
            <div class="table-wrapper" style="background: #010409; padding: 1.5rem; border: 1px solid var(--glass-border);">
                <pre class="mono" style="font-size: 0.75rem; color: var(--text-soft); line-height: 1.8; overflow: hidden;">
<span class="text-cyan">SET</span> WEIGHT_ACTIVITY   = 0.30
<span class="text-cyan">SET</span> WEIGHT_COMPLETION = 0.25
<span class="text-cyan">SET</span> WEIGHT_RETENTION  = 0.20
<span class="text-cyan">SET</span> WEIGHT_REPUTATION = 0.15

<span class="text-healthy">RUN</span> COMPUTE_SCORE() {
  <span class="text-cyan">RETURN</span> (A*0.3 + C*0.25 + R*0.2)
}</pre>
            </div>
        </div>
    </section>

    <!-- FINAL CTA -->
    <section class="glass-panel" style="text-align: center; background: var(--bg-darker); border-color: var(--glass-border-bright);">
        <% if (user) { %>
            <h2 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 1.5rem;">Ready to monitor?</h2>
            <a href="/command-center" class="btn-cyan-solid">Command Center →</a>
        <% } else { %>
            <h2 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 1.5rem;">Ready to initialize?</h2>
            <a href="/auth/register" class="btn-cyan-solid">Get Started Now →</a>
        <% } %>
    </section>
</div>
