<!-- ABOUT HERO -->
<section class="hero" data-aos="fade-zoom-in">
    <div class="hero-aura" style="background: radial-gradient(circle, rgba(0, 245, 255, 0.05) 0%, transparent 70%);"></div>
    <div class="container">
        <div class="badge-pill" data-aos="fade-down" data-aos-delay="200">
            <span class="pulse-dot"></span>
            PROTOCOL_DOCUMENTATION_V3.3
        </div>
        <h1 data-aos="fade-up" data-aos-delay="400">
            <span class="gradient-text">SYSTEM</span>
            <span class="outline-text">PROTOCOL.</span>
        </h1>
        <p class="hero-sub" data-aos="fade-up" data-aos-delay="600">
            PULSE is a high-fidelity intelligence operating system designed to monitor the vital signs of decentralized organizations. Derived from raw telemetry and neural synthesis.
        </p>
    </div>
</section>

<!-- OPERATIONAL FLOW -->
<section class="features" style="padding-top: 0;">
    <div class="container">
        <div style="text-align: left; margin-bottom: 5rem;" data-aos="fade-right">
            <span class="section-label">Operational Flow</span>
            <h2 style="font-family: var(--font-display); font-size: 3rem;">How Pulse reads the void.</h2>
        </div>
        
        <div class="features-grid" style="grid-template-columns: repeat(3, 1fr);">
            <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-icon" style="font-family: var(--font-mono); font-size: 1rem;">[01]</div>
                <h3>Target Identification</h3>
                <p>Every node on the Zero Authority network is identified by a unique cryptographic UUID. Pulse targets these nodes to initialize telemetry.</p>
                <div class="feature-tag">UUID_MAPPING</div>
            </div>
            <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-icon" style="font-family: var(--font-mono); font-size: 1rem;">[02]</div>
                <h3>Telemetry Sync</h3>
                <p>Establish a real-time fetch-and-compute cycle. Pulse synchronizes with live production data directly from the network core.</p>
                <div class="feature-tag">FETCH_SYNC</div>
            </div>
            <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-icon" style="font-family: var(--font-mono); font-size: 1rem;">[03]</div>
                <h3>Vitality Analysis</h3>
                <p>Pulse computes a deterministic health score (0-100) based on five weighted vitality vectors derived from raw activity logs.</p>
                <div class="feature-tag">COMPUTE_ENGINE</div>
            </div>
        </div>
    </div>
</section>

<!-- CORE MODULES (BENTO STYLE) -->
<section class="features" style="background: var(--bg-darker);">
    <div class="container">
        <div style="text-align: center; margin-bottom: 5rem;" data-aos="fade-up">
            <span class="section-label">Core Modules</span>
            <h2 style="font-family: var(--font-display); font-size: 3rem;">Intelligence Infrastructure.</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
            <div class="feature-card" style="grid-column: span 1;" data-aos="fade-right">
                <div class="text-cyan mono" style="font-size: 0.7rem; margin-bottom: 1rem;">MODULE_01</div>
                <h3>Deterministic Health Engine</h3>
                <p>The heart of PULSE. It aggregates raw bounty and contributor data to calculate a normalized health score. This engine refuses to operate on simulated data, ensuring absolute ground truth.</p>
            </div>
            <div class="feature-card" style="grid-column: span 1; border-color: var(--status-warning);" data-aos="fade-left">
                <div class="text-warning mono" style="font-size: 0.7rem; margin-bottom: 1rem;">MODULE_02</div>
                <h3>Neural Insights (Llama 3.3)</h3>
                <p>Powered by Groq inference. This module performs qualitative analysis to detect contributor burnout patterns and synthesize strategic growth opportunities.</p>
            </div>
            <div class="feature-card" style="grid-column: span 2; background: linear-gradient(90deg, var(--bg-card), transparent);" data-aos="fade-up">
                <div class="text-healthy mono" style="font-size: 0.7rem; margin-bottom: 1rem;">MODULE_03</div>
                <h3>Contributor Telemetry Layer</h3>
                <p>A real-time ranked registry tracking reputation scores and engagement intensity. identifies rising stars and high-value participants through behavioral patterns.</p>
            </div>
        </div>
    </div>
</section>

<!-- VITALITY ALGORITHM (TERMINAL STYLE) -->
<section class="features">
    <div class="container">
        <div class="split-section" style="align-items: flex-start;">
            <div data-aos="fade-right">
                <span class="section-label">Algorithm</span>
                <h2 style="font-family: var(--font-display); font-size: 3.5rem; margin-bottom: 2rem;">VITALITY_V1.</h2>
                <p class="text-soft" style="margin-bottom: 3rem; font-size: 1.1rem;">The algorithm prioritizes <strong>Velocity</strong> and <strong>Completion</strong> as the primary indicators of community health.</p>
                
                <div class="mock-card" style="padding: 2rem; border-left: 2px solid var(--accent-cyan);">
                    <div class="card-title">Rationale</div>
                    <p class="text-soft" style="font-size: 0.9rem;">A DAO with high treasury but low production velocity is considered "at-risk." Conversely, high diversity in engagement signals a resilient community structure.</p>
                </div>
            </div>
            <div data-aos="fade-left">
                <div class="mock-browser" style="height: auto;">
                    <div class="browser-header">
                        <div class="dot-group">
                            <div class="dot" style="background: #ff5f56;"></div>
                            <div class="dot" style="background: #ffbd2e;"></div>
                            <div class="dot" style="background: #27c93f;"></div>
                        </div>
                        <div class="browser-url mono">vitality_algorithm.sh</div>
                    </div>
                    <div class="mock-main" style="background: #010409; padding: 2rem;">
                        <pre class="mono" style="font-size: 0.85rem; color: var(--text-soft); line-height: 2;">
<span class="text-cyan">SET</span> WEIGHT_ACTIVITY      = 0.30
<span class="text-cyan">SET</span> WEIGHT_COMPLETION    = 0.25
<span class="text-cyan">SET</span> WEIGHT_RETENTION     = 0.20
<span class="text-cyan">SET</span> WEIGHT_REPUTATION    = 0.15
<span class="text-cyan">SET</span> WEIGHT_DIVERSITY     = 0.10

<span class="text-healthy">RUN</span> COMPUTE_VITALITY_SCORE() {
    <span class="text-muted">// Derived from raw production velocity</span>
    <span class="text-cyan">RETURN</span> (A*0.3 + C*0.25 + R*0.2 + S*0.15 + D*0.1)
}</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FINAL CTA -->
<section class="cta-section" style="background: var(--bg-darker);">
    <div class="cta-bg-glow" style="background: radial-gradient(circle, rgba(0, 245, 255, 0.05) 0%, transparent 70%);"></div>
    <div class="container">
        <% if (user) { %>
            <h2 data-aos="fade-up">Ready to monitor?</h2>
            <p class="text-soft" data-aos="fade-up" data-aos-delay="200">Return to your command center to manage telemetry links.</p>
            <div style="margin-top: 3rem;" data-aos="fade-up" data-aos-delay="400">
                <a href="/command-center" class="btn-cyan-solid btn-lg">Command Center →</a>
            </div>
        <% } else { %>
            <h2 data-aos="fade-up">Ready to initialize?</h2>
            <p class="text-soft" data-aos="fade-up" data-aos-delay="200">Establish a telemetry link with your community today.</p>
            <div style="margin-top: 3rem;" data-aos="fade-up" data-aos-delay="400">
                <a href="/auth/register" class="btn-cyan-solid btn-lg">Get Started Now →</a>
            </div>
        <% } %>
    </div>
</section>
