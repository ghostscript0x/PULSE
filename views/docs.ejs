                    <div class="feature-card">
                        <div class="text-cyan mono" style="font-size: 0.7rem; margin-bottom: 1rem;">STEP_01</div>
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Find DAO UUID</h3>
                        <p class="text-soft" style="font-size: 0.85rem;">Locate the unique identifier for your community on the network registry.</p>
                    </div>
                    <div class="feature-card">
                        <div class="text-cyan mono" style="font-size: 0.7rem; margin-bottom: 1rem;">STEP_02</div>
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Establish Sync</h3>
