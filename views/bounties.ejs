<section style="margin-bottom: 3rem;">
    <div class="mono text-soft" style="font-size: 0.7rem; margin-bottom: 1rem;">[MODULE_07] <span class="text-cyan">SYNC_COUNT: <%= bounties.length %>_BOUNTIES_CAPTURED</span></div>
    <h1 style="margin-bottom: 1rem; letter-spacing: 10px;">BOUNTY_LIFECYCLE</h1>
    <p class="text-soft glow-text" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px;">Production velocity and reward distribution intelligence.</p>
</section>

<% if (bounties.length === 0) { %>
    <section class="glass-panel" style="text-align: center; padding: 6rem 2rem; border-style: dashed;">
        <div class="text-warning glow-text" style="font-size: 2rem; margin-bottom: 1.5rem;">[!]</div>
        <h2 class="text-warning">ZERO_BOUNTIES_DETECTED</h2>
        <p class="text-soft">The target DAO production queue is currently empty or has not been synchronized.</p>
    </section>
<% } else { %>
    <section class="glass-panel" style="padding: 0;">
        <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center;">
            <div class="mono text-soft" style="font-size: 0.7rem;">QUEUE_LENGTH: <%= bounties.length %></div>
            <div class="text-healthy mono" style="font-size: 0.6rem;">● SYNC_STATE: OK</div>
        </div>
        <div class="table-container" style="margin-top: 0;">
            <table>
                <thead>
                    <tr>
                        <th>BOUNTY_IDENTIFIER</th>
                        <th>SIGNAL_STATUS</th>
                        <th>ENGAGEMENT_INTENSITY</th>
                        <th>TIMESTAMP</th>
                    </tr>
                </thead>
                <tbody>
                    <% bounties.forEach(b => { %>
                        <tr>
                            <td class="mono" style="font-size: 0.8rem; letter-spacing: 1px;">
                                <div class="text-cyan" style="font-weight: 700; margin-bottom: 0.2rem;"><%= b.name %></div>
                                <div style="font-size: 0.6rem; opacity: 0.5;"><%= b.id %></div>
                            </td>
                            <td>
                                <% 
                                    let colorClass = 'text-soft';
                                    let bg = 'rgba(170, 180, 192, 0.05)';
                                    
                                    if(b.bountyCompleted || b.status === 'Winner') {
                                        colorClass = 'text-healthy';
                                        bg = 'rgba(0, 255, 136, 0.05)';
                                    } else if(b.status === 'open') {
                                        colorClass = 'text-cyan';
                                        bg = 'rgba(0, 212, 255, 0.05)';
                                    }
                                %>
                                <span class="<%= colorClass %> mono" style="font-size: 0.7rem; background: <%= bg %>; padding: 0.3rem 0.8rem; border-radius: 2px; border: 1px solid currentColor; text-transform: uppercase;">
                                    <%= b.status %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 1rem;">
                                    <div style="flex: 1; min-width: 80px; height: 2px; background: rgba(255,255,255,0.03); position: relative;">
                                        <div style="width: <%= Math.min(100, (b.submissionsCount || 0) * 10) %>%; height: 100%; background: var(--signal-cyan); box-shadow: 0 0 10px var(--signal-cyan);"></div>
                                    </div>
                                    <span class="mono text-soft" style="font-size: 0.7rem;"><%= b.submissionsCount || 0 %>_SUB</span>
                                </div>
                            </td>
                            <td class="text-soft mono" style="font-size: 0.75rem;">
                                <%= new Date(b.createdAt).toISOString().split('T')[0] %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
<% } %>
