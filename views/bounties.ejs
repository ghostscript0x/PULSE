<div class="container" style="padding-top: 4rem;">
    <!-- BOUNTIES HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 4rem;">
        <div class="section-label" data-aos="fade-right">Production Pipeline</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: 3.5rem; line-height: 1;">BOUNTY_LIFE<span class="text-cyan">.</span></h1>
                <p class="text-soft" style="margin-top: 1rem;">Production velocity and reward distribution intelligence.</p>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: center;">
                <div class="mono text-muted" style="font-size: 0.6rem;">SWITCH_NODE:</div>
                <select onchange="window.location.href='/bounties/' + this.value" style="background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-cyan); padding: 0.5rem 1rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.7rem; outline: none; cursor: pointer;">
                    <% if (followedDaos && followedDaos.length > 0) { %>
                        <% followedDaos.forEach(dao => { %>
                            <option value="<%= dao.daoId %>" <%= activeDao === dao.daoId ? 'selected' : '' %>><%= dao.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
        </div>
    </section>

    <!-- METRICS STRIP -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="100">
            <div class="vital-label">Total Bounties</div>
            <div class="vital-value text-cyan"><%= bounties.length %></div>
            <div class="vital-delta text-healthy mono">ACTIVE_PACKETS</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="200">
            <div class="vital-label">Open / Pending</div>
            <div class="vital-value"><%= bounties.filter(b => b.status === 'open' || !b.bountyCompleted).length %></div>
            <div class="vital-delta text-warning mono">AWAITING_WORK</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="300">
            <div class="vital-label">Completed</div>
            <div class="vital-value text-healthy">
                <%= bounties.filter(b => b.bountyCompleted || b.status === 'Winner').length %>
            </div>
            <div class="vital-delta text-healthy mono">VERIFIED_TRUTH</div>
        </div>
        <% 
            // Compute real average reward from actual data
            const rewards = bounties.filter(b => b.reward).map(b => b.reward);
            const avgReward = rewards.length > 0 
                ? Math.round(rewards.reduce((a, b) => a + b, 0) / rewards.length) 
                : null;
        %>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="400">
            <div class="vital-label">Avg Reward</div>
            <div class="vital-value">
                <% if (avgReward !== null) { %>
                    <%= avgReward %> <span style="font-size: 0.8rem; color: var(--text-muted);">USDC</span>
                <% } else { %>
                    <span class="text-warning">N/A</span>
                <% } %>
            </div>
            <div class="vital-delta text-muted mono"><%= rewards.length %> SAMPLED</div>
        </div>
    </div>

    <!-- BOUNTY REGISTRY -->
    <section class="glass-panel" style="padding: 0; overflow: hidden; margin-bottom: 3rem;">
        <div style="padding: 1.5rem; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center;">
            <span class="section-label" style="margin: 0;">Bounty Registry</span>
        </div>

        <% if (bounties.length === 0) { %>
            <div style="padding: 4rem 1.5rem; text-align: center;">
                <div class="text-warning mono" style="font-size: 0.7rem; margin-bottom: 1rem;">[NO_DATA]</div>
                <p class="text-soft" style="font-size: 0.9rem;">No active bounties detected for this node.</p>
            </div>
        <% } else { %>
            <div class="table-wrapper">
                <table style="min-width: 800px;">
                    <thead>
                        <tr>
                            <th>BOUNTY</th>
                            <th>STATUS</th>
                            <th>REWARD</th>
                            <th>MOMENTUM</th>
                        </tr>
                    </thead>
                    <tbody class="mono" style="font-size: 0.75rem;">
                        <% bounties.forEach(b => { %>
                            <%
                                let statusColor = 'var(--accent-cyan)';
                                let statusLabel = b.status || 'OPEN';
                                if(b.bountyCompleted || b.status === 'Winner') {
                                    statusColor = 'var(--accent-green)'; statusLabel = 'COMPLETED';
                                }
                            %>
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.02); cursor: pointer;" onclick="window.location.href='/bounty/<%= b.id %>'">
                                <td style="padding: 1rem;">
                                    <a href="/bounty/<%= b.id %>" class="text-white" style="font-weight: 700; margin-bottom: 0.2rem; display: block; text-decoration: none;"><%= b.name %></a>
                                    <div class="text-muted" style="font-size: 0.55rem;"><%= b.id.substring(0,12) %>...</div>
                                </td>
                                <td>
                                    <span style="color: <%= statusColor %>; border: 1px solid <%= statusColor %>; padding: 0.2rem 0.5rem; border-radius: 2px; font-size: 0.6rem;">
                                        <%= statusLabel.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="text-cyan" style="font-weight: 700;"><%= b.reward ? b.reward + ' USDC' : '—' %></td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 60px; height: 2px; background: rgba(255,255,255,0.05);">
                                            <div style="width: <%= Math.min(100, (b.submissionsCount || 0) * 20) %>%; height: 100%; background: var(--accent-cyan);"></div>
                                        </div>
                                        <span class="text-soft" style="font-size: 0.65rem;"><%= b.submissionsCount || 0 %></span>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <!-- CATEGORIES (derived from actual bounty data or explicit empty state) -->
    <% 
        // Derive categories from actual bounty data if category/type field exists
        // Otherwise show explicit empty state per operational rules
        const categoryMap = {};
        bounties.forEach(b => {
            const cat = b.category || b.type || 'Uncategorized';
            categoryMap[cat] = (categoryMap[cat] || 0) + 1;
        });
        const cats = Object.entries(categoryMap).map(([name, count]) => ({
            name: name,
            icon: '◆',
            count: count
        }));
    %>
    <% if (cats.length > 0) { %>
    <div class="responsive-grid responsive-grid-2" style="margin-bottom: 4rem;">
        <% cats.forEach(cat => { %>
            <div class="feature-card" style="text-align: center; padding: 2rem;">
                <div style="font-size: 1.5rem; color: var(--accent-cyan); margin-bottom: 1rem;"><%= cat.icon %></div>
                <h3 style="font-size: 1rem; margin-bottom: 0.5rem;"><%= cat.name %></h3>
                <div class="mono text-cyan" style="font-size: 1.5rem; font-weight: 700;"><%= cat.count %></div>
            </div>
        <% }) %>
    </div>
    <% } else { %>
    <div style="text-align: center; padding: 2rem; margin-bottom: 4rem; opacity: 0.5;">
        <div class="text-muted mono" style="font-size: 0.7rem;">[CATEGORIES_UNAVAILABLE]</div>
        <p class="text-soft" style="font-size: 0.8rem; margin-top: 0.5rem;">No category data available from API</p>
    </div>
    <% } %>
</div>
