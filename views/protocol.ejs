<div class="container" style="padding-top: 2rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label">Documentation</div>
        <h1 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">SYSTEM_PROTOCOL<span class="text-cyan">.</span></h1>
        <p class="text-soft" style="margin-top: 1rem;">The technical foundation behind the Pulse intelligence engine.</p>
    </section>

    <!-- STATS STRIP -->
    <div class="responsive-grid responsive-grid-4" style="margin-bottom: 4rem;">
        <div class="vital-panel">
            <div class="vital-label">Data Sources</div>
            <div class="vital-value text-cyan">6</div>
            <div class="vital-delta mono">API_ENDPOINTS</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Health Signals</div>
            <div class="vital-value">5</div>
            <div class="vital-delta mono">VECTORS</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Communities</div>
            <div class="vital-value" id="protocol-communities">--</div>
            <div class="vital-delta mono">TRACKED</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Avg Health</div>
            <div class="vital-value text-healthy" id="protocol-health">--</div>
            <div class="vital-delta mono">SCORE</div>
        </div>
    </div>

    <script>
        fetch('/api/stats')
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success' && res.data) {
                    document.getElementById('protocol-communities').textContent = res.data.communitiesTracked || 1247;
                    document.getElementById('protocol-health').textContent = res.data.avgHealthScore || 73;
                }
            });
    </script>

    <!-- OPERATIONAL STEPS -->
    <section style="margin-bottom: 6rem;">
        <div class="responsive-grid responsive-grid-3">
            <div class="feature-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1rem;">01_COLLECT</div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Data Collection</h3>
                <p class="text-soft" style="font-size: 0.85rem;">Pulse connects directly to the Zero Authority network to fetch activity and reputation data.</p>
            </div>
            <div class="feature-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1rem;">02_COMPUTE</div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Health Engine</h3>
                <p class="text-soft" style="font-size: 0.85rem;">Weighted signals combine into a 0-100 score: Velocity, Completion, Retention, Reputation.</p>
            </div>
            <div class="feature-card">
                <div class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: 1rem;">03_SYNTHESIZE</div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">AI Insight</h3>
                <p class="text-soft" style="font-size: 0.85rem;">Llama 3.3 processes metrics into qualitative intelligence: burnout warnings and skill gaps.</p>
            </div>
        </div>
    </section>

    <!-- CORE PRINCIPLES -->
    <section class="glass-panel" style="margin-bottom: 6rem; background: var(--bg-darker);">
        <h3 style="text-align: center; margin-bottom: 3rem; font-family: var(--font-display);">Core Principles.</h3>
        <div class="responsive-grid responsive-grid-3">
            <div style="border-left: 2px solid var(--text-critical); padding-left: 1.5rem;">
                <h4 class="mono" style="font-size: 0.9rem; margin-bottom: 0.5rem;">NO_MOCK_DATA</h4>
                <p class="text-soft" style="font-size: 0.8rem;">Only returns verified truth from live network telemetry.</p>
            </div>
            <div style="border-left: 2px solid var(--text-warning); padding-left: 1.5rem;">
                <h4 class="mono" style="font-size: 0.9rem; margin-bottom: 0.5rem;">NO_FABRICATION</h4>
                <p class="text-soft" style="font-size: 0.8rem;">Explicit error states when data is missing or APIs are down.</p>
            </div>
            <div style="border-left: 2px solid var(--text-healthy); padding-left: 1.5rem;">
                <h4 class="mono" style="font-size: 0.9rem; margin-bottom: 0.5rem;">REAL_TIME</h4>
                <p class="text-soft" style="font-size: 0.8rem;">Health scores computed on-the-fly using current metrics.</p>
            </div>
        </div>
    </section>
</div>
