<div class="container" style="padding-top: 2rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label">Data Intelligence</div>
        <h1 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">ANALYTICS<span class="text-cyan">.</span></h1>
        <p class="text-soft" style="margin-top: 1rem;">Deep historical analysis and qualitative intelligence generated from live telemetry.</p>
    </section>

    <% 
    // Check if user has any tracked DAOs - fetch stats from followed DAOs or show empty state
    const hasTrackedDaos = followedDaos && followedDaos.length > 0;
    %>

    <% if (!hasTrackedDaos) { %>
    <!-- EMPTY STATE - No DAOs tracked -->
    <div class="glass-panel" style="padding: 4rem 2rem; text-align: center; margin-bottom: 4rem;">
        <div class="text-warning mono" style="font-size: 0.7rem; margin-bottom: 1rem;">[NO_DAOS_TRACKED]</div>
        <p class="text-soft" style="font-size: 0.9rem; margin-bottom: 2rem;">Track some DAOs to see real-time intelligence and insights.</p>
        <a href="/command-center" class="btn btn-primary" style="display: inline-block;">INITIALIZE_TRACKING</a>
    </div>
    <% } else { %>
    <!-- REAL DATA FROM TRACKED DAOs -->
    <!-- Show tracked DAO selector -->
    <div style="margin-bottom: 2rem;">
        <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.5rem;">SELECT_DAO:</div>
        <select onchange="window.location.href='/intelligence/' + this.value" style="background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-cyan); padding: 0.5rem 1rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.7rem; outline: none; cursor: pointer;">
            <% followedDaos.forEach(dao => { %>
                <option value="<%= dao.daoId %>"><%= dao.name %></option>
            <% }) %>
        </select>
    </div>

    <!-- AI INSIGHTS - Only available via API call per specific DAO -->
    <div class="glass-panel" style="padding: 2rem; margin-bottom: 4rem;">
        <div class="section-label" style="margin-bottom: 1.5rem;">AI Intelligence</div>
        <p class="text-muted mono" style="font-size: 0.7rem;">
            [INTEL_REQUIRES_SELECTION] Select a DAO above to generate AI-powered insights via Groq.
        </p>
    </div>
    <% } %>

    <!-- NETWORK STATS FROM LOCAL SNAPSHOTS (if any exist) -->
    <% if (typeof snapshotCount !== 'undefined' && snapshotCount > 0) { %>
    <section class="glass-panel" style="margin-bottom: 4rem; padding: 2rem;">
        <span class="section-label" style="margin-bottom: 2rem;">Local Telemetry</span>
        <div class="responsive-grid responsive-grid-4">
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">SNAPSHOTS</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;"><%= snapshotCount %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">NODES</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;"><%= uniqueDaos || 0 %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">AVG_HEALTH</div>
                <div class="text-healthy mono" style="font-size: 1.5rem; font-weight: 700;"><%= avgHealth || '—' %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">STATUS</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;">READY</div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- FOOTER BADGE -->
    <div style="text-align: center; padding-bottom: 4rem; opacity: 0.5;">
        <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px;">NEURAL_SYNTHESIS_ENGINE_ACTIVE</div>
    </div>
</div>