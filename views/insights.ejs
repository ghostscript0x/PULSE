<div class="container" style="padding-top: 2rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label">Data Intelligence</div>
        <h1 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">ANALYTICS<span class="text-cyan">.</span></h1>
        <p class="text-soft" style="margin-top: 1rem;">Deep historical analysis and qualitative intelligence generated from live telemetry.</p>
    </section>

    <% 
    const hasTrackedDaos = followedDaos && followedDaos.length > 0;
    const activeDao = typeof selectedDao !== 'undefined' ? selectedDao : (hasTrackedDaos ? followedDaos[0].daoId : null);
    %>

    <% if (!hasTrackedDaos) { %>
    <!-- EMPTY STATE - No DAOs tracked -->
    <div class="glass-panel" style="padding: 4rem 2rem; text-align: center; margin-bottom: 4rem;">
        <div class="text-warning mono" style="font-size: 0.7rem; margin-bottom: 1rem;">[NO_DAOS_TRACKED]</div>
        <p class="text-soft" style="font-size: 0.9rem; margin-bottom: 2rem;">Track some DAOs to see real-time intelligence and insights.</p>
        <a href="/command-center" class="btn btn-primary" style="display: inline-block;">INITIALIZE_TRACKING</a>
    </div>
    <% } else { %>
    <!-- DAO SELECTOR -->
    <div style="margin-bottom: 2rem;">
        <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.5rem;">SELECT_DAO:</div>
        <select id="daoSelector" onchange="window.location.href='/insights?dao=' + this.value" style="background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-cyan); padding: 0.5rem 1rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.7rem; outline: none; cursor: pointer;">
            <% followedDaos.forEach(dao => { %>
                <option value="<%= dao.daoId %>" <%= activeDao === dao.daoId ? 'selected' : '' %>><%= dao.name %></option>
            <% }) %>
        </select>
    </div>

    <!-- AI INSIGHTS SECTION -->
    <div id="insightsSection" class="glass-panel" style="padding: 2rem; margin-bottom: 4rem;">
        <div class="section-label" style="margin-bottom: 1.5rem;">AI Intelligence</div>
        
        <div id="insightsLoading" style="text-align: center; padding: 2rem;">
            <div class="mono text-cyan" style="font-size: 0.7rem;">[FETCHING_INTEL]</div>
        </div>
        
        <div id="insightsContent" style="display: none;">
            <div id="insightsSummary" style="margin-bottom: 1.5rem;">
                <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.5rem;">EXECUTIVE_SUMMARY</div>
                <p class="text-soft" style="font-size: 0.9rem; line-height: 1.7;"></p>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 1.5rem;">
                <div>
                    <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.75rem;">RISKS</div>
                    <ul id="insightsRisks" class="mono text-warning" style="font-size: 0.75rem; padding-left: 1rem;"></ul>
                </div>
                <div>
                    <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.75rem;">OPPORTUNITIES</div>
                    <ul id="insightsOpportunities" class="mono text-healthy" style="font-size: 0.75rem; padding-left: 1rem;"></ul>
                </div>
                <div>
                    <div class="mono text-muted" style="font-size: 0.6rem; margin-bottom: 0.75rem;">ALERTS</div>
                    <ul id="insightsAlerts" class="mono text-critical" style="font-size: 0.75rem; padding-left: 1rem;"></ul>
                </div>
            </div>
        </div>
        
        <div id="insightsError" style="display: none; text-align: center; padding: 2rem;">
            <div class="mono text-warning" style="font-size: 0.7rem; margin-bottom: 0.5rem;">[INTEL_UNAVAILABLE]</div>
            <p class="text-soft" style="font-size: 0.8rem;"></p>
        </div>
    </div>
    
    <script>
        function loadInsights(daoId) {
            if (!daoId) {
                console.log('[FRONTEND] No daoId provided');
                return;
            }
            
            console.log('[FRONTEND] Loading insights for:', daoId);
            
            const loading = document.getElementById('insightsLoading');
            const content = document.getElementById('insightsContent');
            const error = document.getElementById('insightsError');
            
            loading.style.display = 'block';
            content.style.display = 'none';
            error.style.display = 'none';
            
            fetch('/api/insights/' + daoId)
                .then(res => {
                    console.log('[FRONTEND] Response status:', res.status);
                    if (!res.ok) {
                        return res.json().then(err => {
                            throw new Error(err.message || `HTTP ${res.status}`);
                        });
                    }
                    return res.json();
                })
                .then(data => {
                    console.log('[FRONTEND] Response data:', data);
                    loading.style.display = 'none';
                    
                    if (data.status === 'success' && data.data) {
                        content.style.display = 'block';
                        
                        // Summary
                        document.querySelector('#insightsSummary p').textContent = data.data.summary || 'No summary available';
                        
                        // Risks
                        const risksList = document.getElementById('insightsRisks');
                        risksList.innerHTML = '';
                        (data.data.risks || []).forEach(risk => {
                            const li = document.createElement('li');
                            li.textContent = risk;
                            li.style.marginBottom = '0.5rem';
                            risksList.appendChild(li);
                        });
                        if (data.data.risks && data.data.risks.length === 0) {
                            risksList.innerHTML = '<li class="text-muted">No risks detected</li>';
                        }
                        
                        // Opportunities
                        const oppList = document.getElementById('insightsOpportunities');
                        oppList.innerHTML = '';
                        (data.data.opportunities || []).forEach(opp => {
                            const li = document.createElement('li');
                            li.textContent = opp;
                            li.style.marginBottom = '0.5rem';
                            oppList.appendChild(li);
                        });
                        if (data.data.opportunities && data.data.opportunities.length === 0) {
                            oppList.innerHTML = '<li class="text-muted">No opportunities identified</li>';
                        }
                        
                        // Alerts
                        const alertsList = document.getElementById('insightsAlerts');
                        alertsList.innerHTML = '';
                        (data.data.alerts || []).forEach(alert => {
                            const li = document.createElement('li');
                            li.textContent = alert;
                            li.style.marginBottom = '0.5rem';
                            alertsList.appendChild(li);
                        });
                        if (data.data.alerts && data.data.alerts.length === 0) {
                            alertsList.innerHTML = '<li class="text-muted">No alerts</li>';
                        }
                        
                        console.log('[FRONTEND] Insights displayed successfully');
                    } else {
                        console.error('[FRONTEND] Error in response:', data);
                        error.style.display = 'block';
                        const errorMsg = data.code === 'INSUFFICIENT_DATA' 
                            ? 'No telemetry data available. Visit the Intelligence page to sync data first.'
                            : (data.message || data.data?.message || 'Failed to load insights');
                        error.querySelector('p').textContent = errorMsg;
                    }
                })
                .catch(err => {
                    console.error('[FRONTEND] Fetch error:', err);
                    loading.style.display = 'none';
                    error.style.display = 'block';
                    error.querySelector('p').textContent = 'Error: ' + err.message;
                });
        }
        
        // Auto-load on page load if DAO is selected
        document.addEventListener('DOMContentLoaded', function() {
            const selector = document.getElementById('daoSelector');
            if (selector && selector.value) {
                console.log('[FRONTEND] Auto-loading insights for:', selector.value);
                loadInsights(selector.value);
            } else {
                console.log('[FRONTEND] No DAO selected in selector');
            }
        });
    </script>
    <% } %>

    <!-- NETWORK STATS FROM LOCAL SNAPSHOTS -->
    <% if (typeof snapshotCount !== 'undefined' && snapshotCount > 0) { %>
    <section class="glass-panel" style="margin-bottom: 4rem; padding: 2rem;">
        <span class="section-label" style="margin-bottom: 2rem;">Local Telemetry</span>
        <div class="responsive-grid responsive-grid-4">
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">SNAPSHOTS</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;"><%= snapshotCount %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">NODES</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;"><%= uniqueDaos || 0 %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">AVG_HEALTH</div>
                <div class="text-healthy mono" style="font-size: 1.5rem; font-weight: 700;"><%= avgHealth || '—' %></div>
            </div>
            <div style="text-align: center;">
                <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">STATUS</div>
                <div class="text-cyan mono" style="font-size: 1.5rem; font-weight: 700;">READY</div>
            </div>
        </div>
    </section>
    <% } %>

    <div style="text-align: center; padding-bottom: 4rem; opacity: 0.5;">
        <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px;">NEURAL_SYNTHESIS_ENGINE_ACTIVE</div>
    </div>
</div>