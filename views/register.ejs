<div class="container" style="min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
    <div class="hero-aura-enhanced" style="width: 300px; height: 300px; position: absolute;" aria-hidden="true"></div>
    <div style="width: 100%; max-width: 420px; position: relative; z-index: 1;">
        <section class="glass-panel premium-card card-accent-top" style="padding: 2rem 1.5rem;" data-aos="fade-in-up">
            <div class="section-label" style="text-align: center; margin-bottom: 1.5rem;">Registry Access</div>
            <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 2rem); text-align: center; margin-bottom: 2rem; line-height: 1.1;">REGISTER NODE<span class="text-gradient">.</span></h2>

            <% if(typeof errors != 'undefined') { %>
                <% errors.forEach(function(error) { %>
                    <div class="alert-error" style="margin-bottom: 1rem;" role="alert">
                        <div class="text-critical mono" style="font-size: 0.75rem; text-align: center;">[FAULT] <%= error.msg %></div>
                    </div>
                <% }); %>
            <% } %>

            <form action="/auth/register" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;" novalidate>
                <div class="form-group">
                    <label for="username" class="form-label">USERNAME</label>
                    <input type="text" id="username" name="username" value="<%= typeof username != 'undefined' ? username : '' %>" required
                        class="form-input" placeholder="Choose your username" autocomplete="username">
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">ACCESS_KEY</label>
                    <input type="password" id="password" name="password" required
                        class="form-input" placeholder="Create a password" autocomplete="new-password">
                </div>
                <div class="form-group">
                    <label for="confirmPassword" class="form-label">CONFIRM_KEY</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required
                        class="form-input" placeholder="Confirm your password" autocomplete="new-password">
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem; width: 100%;">INITIALIZE_NODE</button>
            </form>

            <div style="margin-top: 2rem; text-align: center;">
                <a href="/auth/login" class="btn-link" style="font-size: 0.875rem;">ALREADY REGISTERED? →</a>
            </div>
        </section>
    </div>
</div>
