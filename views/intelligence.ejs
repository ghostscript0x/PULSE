<div class="container" style="padding-top: 2rem;">
    <!-- BACKGROUND AURA -->
    <div class="hero-aura-enhanced"></div>

    <!-- HEADER SECTION -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label" data-aos="fade-right">Intelligence Center</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 3.5rem); line-height: 1; margin: 0;">INTELLIGENCE<span class="text-gradient">.</span></h1>
                <p class="text-soft" style="margin-top: 0.5rem; font-size: 0.95rem;">Community health report derived from live network telemetry.</p>
            </div>
            
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 1rem;">
                <!-- NODE SELECTOR -->
                <div class="glass-panel premium-card" style="display: flex; gap: 1rem; align-items: center; padding: 0.75rem 1rem;">
                    <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 1px;">SWITCH_NODE:</div>
                    <label for="node-selector" class="sr-only">Select DAO node</label>
                    <select id="node-selector" onchange="handleNodeSwitch(this.value)">
                        <% if (followedDaos && followedDaos.length > 0) { %>
                            <% followedDaos.forEach(dao => { %>
                                <option value="<%= dao.daoId %>" <%= latest && latest.daoId === dao.daoId ? 'selected' : '' %>><%= dao.name %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="">NO_NODES_FOUND</option>
                        <% } %>
                        <option value="DISCOVER_ACTION">+ DISCOVER_NEW</option>
                    </select>
                </div>

                <script>
                    function handleNodeSwitch(val) {
                        if (val === 'DISCOVER_ACTION') {
                            window.location.href = '/command-center';
                        } else if (val) {
                            window.location.href = '/intelligence/' + val;
                        }
                    }
                </script>

                <% if (latest) { %>
                    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; justify-content: flex-end;">
                        <a href="https://zeroauthoritydao.com/dao/<%= latest.daoId %>" target="_blank" class="btn-ghost" style="font-size: 0.55rem; padding: 0.4rem 0.8rem;">
                            VERIFY_ON_CHAIN
                        </a>
                        <div class="gradient-border mono text-cyan" style="font-size: 0.65rem; padding: 0.4rem 0.8rem; border-radius: 4px;">
                            NODE: <%= latest.daoId.substring(0,12) %>...
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <% if (!latest) { %>
        <!-- INITIALIZE MONITORING (EMPTY STATE) -->
        <div class="glass-panel premium-card gradient-border" style="padding: 5rem 1.5rem; text-align: center; border: 1px dashed var(--glass-border);">
            <div class="text-warning pulse-ring mono" style="font-size: 0.65rem; margin-bottom: 2rem; letter-spacing: 3px; display: inline-block; padding: 0.5rem 1rem;">[AWAITING_TELEMETRY]</div>
            <h2 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 1rem;">Initialize Monitoring.</h2>
            <p class="text-soft" style="max-width: 500px; margin: 0 auto 2.5rem; font-size: 0.95rem;">Provide a target community identifier to initialize real-time tracking and health computation.</p>
            
            <form id="init-telemetry-form" class="premium-card" style="max-width: 450px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem;">
                <input type="text" id="init-daoId" placeholder="TARGET_DAO_UUID" required class="form-input" style="text-align: center;">
                <button type="submit" class="btn-glow" style="width: 100%;">INITIALIZE_SYNC</button>
            </form>

            <div style="margin-top: 4rem;">
                <span class="section-label" style="margin-bottom: 2rem;">Discovery Registry</span>
                <div id="discovery-list" class="responsive-grid responsive-grid-3">
                    <div class="text-soft mono shimmer" style="text-align: center; grid-column: 1 / -1; font-size: 0.65rem; padding: 2rem;">SCANNING_NETWORK...</div>
                </div>
            </div>
        </div>

        <script>
            fetch('/api/discovery')
                .then(res => res.json())
                .then(res => {
                    const list = document.getElementById('discovery-list');
                    const orgs = res.data?.organizations || (Array.isArray(res.data) ? res.data : []);
                    if (res.status === 'success' && orgs.length > 0) {
                        list.innerHTML = orgs.slice(0, 6).map(org => `
                            <div class="glass-panel" style="cursor: pointer; padding: 1.25rem; text-align: left; border-left: 1px solid var(--accent-cyan);" onclick="initializeLink('${escapeHtml(org.id)}')">
                                <div class="text-white mono" style="font-size: 0.75rem; font-weight: 700; margin-bottom: 0.25rem;">${escapeHtml(org.name) || 'UNKNOWN'}</div>
                                <div class="mono text-muted" style="font-size: 0.55rem;">ID: ${escapeHtml(org.id.substring(0,18))}...</div>
                            </div>
                        `).join('');
                    } else {
                        list.innerHTML = '<div class="text-soft mono" style="text-align: center; grid-column: 1 / -1;">NO_COMMUNITIES_FOUND</div>';
                    }
                });

            // HTML escape function to prevent XSS
            function escapeHtml(text) {
                if (!text) return '';
                return text
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function initializeLink(id) {
                document.getElementById('init-daoId').value = id;
                document.getElementById('init-telemetry-form').dispatchEvent(new Event('submit'));
            }

            document.getElementById('init-telemetry-form').onsubmit = function(e) {
                e.preventDefault();
                const daoId = document.getElementById('init-daoId').value.trim().replace(/[^a-zA-Z0-9_-]/g, '');
                if(daoId) {
                    const btn = this.querySelector('button');
                    btn.innerText = 'SYNCING...'; btn.disabled = true;
                    fetch(`/api/health/${daoId}`)
                        .then(res => res.json())
                        .then(res => {
                            if(res.status === 'success') window.location.reload();
                            else alert('SYNC_ERROR: ' + res.message);
                        }).finally(() => { btn.innerText = 'INITIALIZE_SYNC'; btn.disabled = false; });
                }
            };
        </script>
    <% } else { %>
        <!-- CORE TELEMETRY METRICS -->
        <div class="responsive-grid responsive-grid-4" style="margin-bottom: 2.5rem;">
            <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-green); padding: 1.5rem;">
                <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">HEALTH_SCORE</div>
                <div style="display: flex; align-items: baseline; gap: 0.5rem;">
                    <div class="<%= latest.healthScore > 70 ? 'text-healthy text-gradient' : 'text-warning' %>" style="font-size: 2.2rem; font-weight: 800; font-family: var(--font-display);"><%= latest.healthScore %></div>
                    <div class="<%= latest.healthScore > 70 ? 'text-healthy' : 'text-warning' %> mono" style="font-size: 0.6rem;"><%= latest.healthScore > 70 ? 'THRIVING' : 'AT_RISK' %></div>
                </div>
            </div>
            <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-cyan); padding: 1.5rem;">
                <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">CONTRIBUTORS</div>
                <div class="text-cyan" style="font-size: 2.2rem; font-weight: 800; font-family: var(--font-display);"><%= latest.rawLiveData?.contributors?.length || 0 %></div>
            </div>
            <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-green); padding: 1.5rem;">
                <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">COMPLETION</div>
                <div class="text-healthy" style="font-size: 2.2rem; font-weight: 800; font-family: var(--font-display);"><%= Math.round(latest.metrics?.completionRate || 0) %>%</div>
            </div>
            <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-cyan); padding: 1.5rem;">
                <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">BOUNTIES</div>
                <div class="text-cyan" style="font-size: 2.2rem; font-weight: 800; font-family: var(--font-display);"><%= latest.rawLiveData?.bounties?.length || 0 %></div>
            </div>
        </div>

        <div class="responsive-grid responsive-grid-2" style="align-items: start; gap: 1.5rem;">
            <!-- LEFT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <section class="glass-panel premium-card" style="text-align: center; padding: 3rem 2rem;">
                    <span class="section-label" style="margin-bottom: 2.5rem;">Vitality Ring</span>
                    <div class="gauge-container pulse-ring" style="max-width: 220px;">
                        <svg class="gauge-svg" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="5" />
                            <circle cx="50" cy="50" r="45" fill="none" stroke="url(#dashGrad)" stroke-width="5" 
                                stroke-dasharray="283" stroke-dashoffset="<%= 283 - (283 * latest.healthScore / 100) %>" 
                                stroke-linecap="round" style="filter: drop-shadow(0 0 8px var(--accent-cyan));" />
                        </svg>
                        <div class="gauge-center">
                            <div class="gauge-number text-gradient"><%= latest.healthScore %></div>
                        </div>
                    </div>
                </section>

                <section class="glass-panel premium-card">
                    <span class="section-label" style="margin-bottom: 2rem;">Score Metrics</span>
                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        <% const metrics = [
                            { label: 'Activity Velocity', val: latest.metrics?.velocity || 0 },
                            { label: 'Bounty Completion', val: latest.metrics?.completionRate || 0 },
                            { label: 'Retention Rate', val: latest.metrics?.retention || 0 },
                            { label: 'Reputation Growth', val: (latest.metrics?.reputationGrowth || 85) }
                        ] %>
                        <% metrics.forEach(m => { %>
                            <div>
                                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 0.5rem;">
                                    <span class="text-soft mono"><%= m.label.toUpperCase() %></span>
                                    <span class="mono text-cyan"><%= Math.round(m.val) %></span>
                                </div>
                                <div class="bar-bg">
                                    <div class="bar-fill" style="width: <%= m.val %>%;"></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </section>
            </div>

            <!-- RIGHT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <section class="glass-panel premium-card" id="ai-insights-panel" style="min-height: 250px; border-left: 3px solid var(--accent-cyan);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <span class="section-label" style="margin: 0;">Neural Synthesis</span>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span class="pulse-dot" style="width: 4px; height: 4px;"></span>
                            <span class="mono text-cyan" style="font-size: 0.55rem; opacity: 0.7;">INFERENCE_ACTIVE</span>
                        </div>
                    </div>
                    <div class="text-soft mono shimmer" style="font-size: 0.75rem; padding: 1rem;">INITIALIZING_NEURAL_LAYERS...</div>
                </section>

                <section class="glass-panel premium-card" style="padding: 0; overflow: hidden;">
                    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center;">
                        <span class="section-label" style="margin: 0;">Activity Feed</span>
                        <span class="mono text-muted" style="font-size: 0.55rem;">NODE_0x73...</span>
                    </div>
                    <div class="table-wrapper">
                        <table style="min-width: 450px;">
                            <tbody class="mono" style="font-size: 0.75rem;">
                                <% if (latest.rawLiveData?.bounties && latest.rawLiveData.bounties.length > 0) { %>
                                    <% latest.rawLiveData.bounties.slice(0, 5).forEach(b => { %>
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                            <td style="padding: 1rem; color: var(--text-muted);">EVENT_SYNC</td>
                                            <td style="padding: 1rem;" class="text-cyan"><%= b.id.substring(0, 12) %>...</td>
                                            <td style="padding: 1rem;" class="text-healthy">VERIFIED</td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" style="text-align: center; padding: 4rem; color: var(--text-muted);">AWAITING_ACTIVITY_PACKETS...</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>

        <script>
            const daoId = "<%= latest.daoId %>";
            fetch(`/api/insights/${daoId}`)
                .then(res => res.json())
                .then(res => {
                    const panel = document.getElementById('ai-insights-panel');
                    if (res.status === 'success' && res.data) {
                        const d = res.data;
                        panel.innerHTML = `
                            <div style="display: flex; flex-direction: column; gap: 2rem;">
                                <div>
                                    <div class="mono text-cyan" style="font-size: 0.6rem; margin-bottom: 0.75rem; letter-spacing: 1px;">STRATEGIC_SUMMARY</div>
                                    <p class="text-soft" style="font-size: 0.85rem; line-height: 1.7; border-left: 1px solid var(--accent-cyan); padding-left: 1rem;">${escapeHtml(d.summary)}</p>
                                </div>
                                <div class="responsive-grid responsive-grid-2" style="gap: 1.5rem;">
                                    <div>
                                        <div class="mono text-warning" style="font-size: 0.6rem; margin-bottom: 0.75rem; letter-spacing: 1px;">RISK_VECTORS</div>
                                        <ul style="list-style: none; padding: 0; font-size: 0.75rem; color: var(--text-soft);" class="mono">
                                            ${d.risks.map(r => `<li style="margin-bottom: 0.4rem;">! ${escapeHtml(r)}</li>`).join('')}
                                        </ul>
                                    </div>
                                    <div>
                                        <div class="mono text-healthy" style="font-size: 0.6rem; margin-bottom: 0.75rem; letter-spacing: 1px;">GROWTH_SIGNALS</div>
                                        <ul style="list-style: none; padding: 0; font-size: 0.75rem; color: var(--text-soft);" class="mono">
                                            ${d.opportunities.map(o => `<li style="margin-bottom: 0.4rem;">+ ${escapeHtml(o)}</li>`).join('')}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        `;
                    } else {
                        panel.innerHTML = '<div class="text-muted mono" style="font-size: 0.8rem;">[AI_OFFLINE] CONFIGURE_API_KEY</div>';
                    }
                })
                .catch(() => {
                    document.getElementById('ai-insights-panel').innerHTML = '<div class="text-muted mono" style="font-size: 0.8rem;">[ERROR] INFERENCE_FAILED</div>';
                });
        </script>
    <% } %>
</div>
