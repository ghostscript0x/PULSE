<div class="container" style="padding-top: 2rem;">
    <!-- DASHBOARD HEADER -->
    <div class="hero-aura-enhanced"></div>
    
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label" data-aos="fade-right">Ecosystem Overview</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 3.5rem); line-height: 1; margin: 0;">DASHBOARD<span class="text-gradient">.</span></h1>
                <p class="text-soft" style="margin-top: 0.5rem; font-size: 0.95rem;">Real-time telemetry across the Zero Authority network.</p>
            </div>
            <div class="mono text-cyan gradient-border" style="font-size: 0.65rem; padding: 0.5rem 1rem; border-radius: 4px; background: rgba(0,212,255,0.03); letter-spacing: 1px;">
                STATUS: <span class="text-healthy pulse-ring" style="padding-left: 0.5rem;">● OPERATIONAL</span>
            </div>
        </div>
    </section>

    <!-- GLOBAL METRICS -->
    <div class="responsive-grid responsive-grid-3" style="margin-bottom: 2.5rem;">
        <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-green); padding: 1.5rem;">
            <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">ECOSYSTEM_HEALTH</div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem;">
                <div class="text-healthy" style="font-size: 2.5rem; font-weight: 800; font-family: var(--font-display);"><%= stats.healthScore %></div>
                <% if (stats.healthScore >= 70) { %>
                    <div class="text-healthy mono" style="font-size: 0.65rem;">↑ STABLE</div>
                <% } else if (stats.healthScore >= 40) { %>
                    <div class="text-warning mono" style="font-size: 0.65rem;">↓ CAUTION</div>
                <% } else { %>
                    <div class="text-critical mono" style="font-size: 0.65rem;">↓ CRITICAL</div>
                <% } %>
            </div>
            <div class="text-muted mono" style="font-size: 0.55rem; margin-top: 0.5rem;">
                <%= stats.healthScore >= 70 ? 'VITALITY_INDEX_STABLE' : (stats.healthScore >= 40 ? 'VITALITY_INDEX_DEGRADED' : 'VITALITY_INDEX_CRITICAL') %>
            </div>
        </div>
        
        <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-cyan); padding: 1.5rem;">
            <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">ACTIVE_NODES</div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem;">
                <div class="text-cyan" style="font-size: 2.5rem; font-weight: 800; font-family: var(--font-display);"><%= (stats.activeContributors || 0).toLocaleString() %></div>
                <div class="text-cyan mono" style="font-size: 0.65rem;">LIVE</div>
            </div>
            <div class="text-muted mono" style="font-size: 0.55rem; margin-top: 0.5rem;">CONTRIBUTOR_NETWORK_ACTIVE</div>
        </div>

        <div class="glass-panel premium-card" style="border-top: 3px solid var(--accent-green); padding: 1.5rem;">
            <div class="mono text-muted" style="font-size: 0.6rem; letter-spacing: 2px; margin-bottom: 1rem;">COMPLETION_RATE</div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem;">
                <div class="text-healthy" style="font-size: 2.5rem; font-weight: 800; font-family: var(--font-display);"><%= stats.completionRate || 0 %>%</div>
                <div class="text-healthy mono" style="font-size: 0.65rem;">OPTIMIZED</div>
            </div>
            <div class="text-muted mono" style="font-size: 0.55rem; margin-top: 0.5rem;">PRODUCTION_VELOCITY_PEAK</div>
        </div>
    </div>

    <div class="responsive-grid responsive-grid-2" style="margin-bottom: 4rem; align-items: start;">
        <!-- LEFT: ECOSYSTEM VITALITY -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <section class="glass-panel premium-card" style="text-align: center; padding: 3rem 2rem; background: radial-gradient(circle at center, rgba(0,245,255,0.05) 0%, transparent 100%);">
                <span class="section-label" style="margin-bottom: 2.5rem;">Network Vitality</span>
                <div class="gauge-container pulse-ring" style="max-width: 240px;">
                    <svg class="gauge-svg" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="5" />
                        <circle cx="50" cy="50" r="45" fill="none" stroke="url(#dashGrad)" stroke-width="5" 
                            stroke-dasharray="283" stroke-dashoffset="<%= 283 - (283 * stats.healthScore / 100) %>" 
                            stroke-linecap="round" style="filter: drop-shadow(0 0 8px var(--accent-cyan));" />
                        <defs>
                            <linearGradient id="dashGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="var(--accent-cyan)" />
                                <stop offset="100%" stop-color="var(--accent-green)" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="gauge-center">
                        <div class="gauge-number text-gradient"><%= stats.healthScore %></div>
                        <div class="mono text-soft" style="font-size: 0.6rem; margin-top: 0.5rem; letter-spacing: 2px;">INDEX</div>
                    </div>
                </div>
                <div class="mono <%= stats.healthScore >= 70 ? 'text-healthy' : (stats.healthScore >= 40 ? 'text-warning' : 'text-critical') %>" style="font-size: 0.65rem; margin-top: 2.5rem; letter-spacing: 3px;">
                <%= stats.healthScore >= 70 ? 'STATUS_THRIVING' : (stats.healthScore >= 40 ? 'STATUS_DEGRADED' : 'STATUS_CRITICAL') %>
            </div>
            </section>

            <a href="/intelligence" class="btn-glow" style="padding: 1.25rem; text-align: center; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 1px;">
                INITIALIZE_SPECIFIC_TELEMETRY →
            </a>
        </div>

        <!-- RIGHT: NEURAL SYNTHESIS & RECENT ACTIVITY -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <section class="glass-panel premium-card" style="border-left: 3px solid var(--accent-cyan);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <span class="section-label" style="margin: 0;">Ecosystem Synthesis</span>
                    <span class="mono text-cyan" style="font-size: 0.55rem; opacity: 0.6;">LLAMA_3.3_INFERENCE</span>
                </div>
                <% 
                    const health = stats.healthScore || 0;
                    const statusText = health >= 70 ? 'Optimal Performance' : (health >= 40 ? 'Moderate Activity' : 'Degraded State');
                    const riskLevel = health >= 70 ? 'LOW_RISK' : (health >= 40 ? 'MODERATE_RISK' : 'HIGH_RISK');
                %>
                <p class="text-soft" style="font-size: 0.9rem; line-height: 1.8;">
                    Network core is currently exhibiting <span class="text-white"><%= statusText %></span>. 
                    <% if (stats.activeContributors) { %>
                        Active contributor count: <%= stats.activeContributors %>.
                    <% } else { %>
                        Telemetry data pending synchronization.
                    <% } %>
                </p>
                <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <span class="feature-tag" style="background: <%= riskLevel === 'LOW_RISK' ? 'rgba(0,255,136,0.1)' : (riskLevel === 'MODERATE_RISK' ? 'rgba(255,170,0,0.1)' : 'rgba(255,68,68,0.1)') %>; color: <%= riskLevel === 'LOW_RISK' ? 'var(--accent-green)' : (riskLevel === 'MODERATE_RISK' ? 'var(--status-warning)' : 'var(--accent-critical)') %>;"><%= riskLevel %></span>
                    <% if (stats.completionRate >= 60) { %>
                        <span class="feature-tag" style="background: rgba(0,245,255,0.1); color: var(--accent-cyan);">VELOCITY_NORMAL</span>
                    <% } %>
                </div>
            </section>

            <!-- ACTIVITY HEATMAP - Aggregate across all tracked DAOs -->
            <%
            // Aggregate all contributor activity from snapshots
            let allContributors = [];
            if (recentActivity && recentActivity.length > 0) {
                recentActivity.forEach(snap => {
                    if (snap.rawLiveData && snap.rawLiveData.contributors) {
                        allContributors = allContributors.concat(snap.rawLiveData.contributors);
                    }
                });
            }
            
            const days = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
            const timeBlocks = ['12AM-6AM', '6AM-12PM', '12PM-6PM', '6PM-12AM'];
            
            // Build heatmap from contributor timestamps
            const heatmapData = Array(4).fill(null).map(() => Array(7).fill(0));
            
            allContributors.forEach(c => {
                if (c.lastActive) {
                    try {
                        const date = new Date(c.lastActive);
                        if (!isNaN(date.getTime())) {
                            const dayOfWeek = date.getDay();
                            const hour = date.getHours();
                            let blockIdx = 0;
                            if (hour >= 6 && hour < 12) blockIdx = 1;
                            else if (hour >= 12 && hour < 18) blockIdx = 2;
                            else if (hour >= 18) blockIdx = 3;
                            const dayIdx = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
                            heatmapData[blockIdx][dayIdx]++;
                        }
                    } catch (e) {}
                }
            });
            
            const maxActivity = Math.max(...heatmapData.flat(), 1);
            const realHeatmap = heatmapData.map(row => row.map(val => Math.round((val / maxActivity) * 100)));
            %>
            
            <section class="glass-panel premium-card" style="padding: 0; overflow: hidden;">
                <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center;">
                    <span class="section-label" style="margin: 0;">ECOSYSTEM ACTIVITY MAP</span>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <% if (allContributors.length > 0) { %>
                            <span class="pulse-dot" style="width: 4px; height: 4px;"></span>
                            <span class="text-healthy mono" style="font-size: 0.55rem;">LIVE_DATA <%= allContributors.length %> NODES</span>
                        <% } else { %>
                            <span class="text-muted mono" style="font-size: 0.55rem;">PENDING</span>
                        <% } %>
                    </div>
                </div>
                
                <div style="padding: 1.5rem;">
                    <% if (allContributors.length > 0) { %>
                    <!-- Day labels -->
                    <div style="display: flex; margin-left: 55px; margin-bottom: 0.5rem;">
                        <% days.forEach(day => { %>
                            <div style="flex: 1; text-align: center; font-size: 0.55rem; color: var(--text-muted);"><%= day %></div>
                        <% }); %>
                    </div>
                    
                    <!-- Heatmap grid -->
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <% timeBlocks.forEach((block, blockIdx) => { %>
                        <div style="display: flex; align-items: center; gap: 0;">
                            <div class="mono text-muted" style="font-size: 0.5rem; width: 50px; text-align: right; padding-right: 8px;"><%= block %></div>
                            <div style="display: flex; gap: 4px; flex: 1;">
                                <% days.forEach((day, dayIdx) => { 
                                    const intensity = realHeatmap[blockIdx][dayIdx];
                                    const rawCount = heatmapData[blockIdx][dayIdx];
                                    let bgColor, glow;
                                    if (intensity > 80) { 
                                        bgColor = 'rgba(34, 197, 94, 0.8)'; 
                                        glow = 'box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);';
                                    } else if (intensity > 60) { 
                                        bgColor = 'rgba(6, 182, 212, 0.7)'; 
                                        glow = 'box-shadow: 0 0 6px rgba(6, 182, 212, 0.5);';
                                    } else if (intensity > 40) { 
                                        bgColor = 'rgba(6, 182, 212, 0.4)'; 
                                        glow = '';
                                    } else if (intensity > 20) { 
                                        bgColor = 'rgba(107, 114, 128, 0.4)'; 
                                        glow = '';
                                    } else { 
                                        bgColor = 'rgba(55, 65, 81, 0.5)'; 
                                        glow = '';
                                    }
                                %>
                                <div style="flex: 1; height: 32px; background: <%= bgColor %>; border-radius: 3px; <%= glow %>" title="<%= day %> <%= block %>: <%= rawCount %> activities"></div>
                                <% }); %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    
                    <!-- Legend -->
                    <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; justify-content: center;">
                        <span class="mono text-muted" style="font-size: 0.5rem;">LESS</span>
                        <div style="display: flex; gap: 3px;">
                            <div style="width: 16px; height: 16px; background: rgba(55, 65, 81, 0.5); border-radius: 2px;"></div>
                            <div style="width: 16px; height: 16px; background: rgba(107, 114, 128, 0.4); border-radius: 2px;"></div>
                            <div style="width: 16px; height: 16px; background: rgba(6, 182, 212, 0.4); border-radius: 2px;"></div>
                            <div style="width: 16px; height: 16px; background: rgba(6, 182, 212, 0.7); border-radius: 2px; box-shadow: 0 0 4px rgba(6, 182, 212, 0.5);"></div>
                            <div style="width: 16px; height: 16px; background: rgba(34, 197, 94, 0.8); border-radius: 2px; box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);"></div>
                        </div>
                        <span class="mono text-muted" style="font-size: 0.5rem;">MORE</span>
                    </div>
                    <% } else { %>
                    <div style="text-align: center; padding: 2rem;">
                        <div class="text-muted mono" style="font-size: 0.6rem; margin-bottom: 0.5rem;">[NO_TELEMETRY]</div>
                        <p class="text-soft" style="font-size: 0.8rem;">Track DAOs to see ecosystem activity patterns.</p>
                    </div>
                    <% } %>
                </div>
            </section>
        </div>
    </div>

    <!-- QUICK ACCESS STRIP -->
    <% if (followedDaos && followedDaos.length > 0) { %>
        <section style="margin-bottom: 6rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <span class="section-label" style="margin: 0;">Your Tracked Nodes</span>
                <a href="/command-center" class="mono text-soft" style="font-size: 0.6rem; text-decoration: none;">MANAGE_ALL →</a>
            </div>
            <div class="responsive-grid responsive-grid-4">
                <% followedDaos.slice(0, 4).forEach(dao => { %>
                    <a href="/intelligence/<%= dao.daoId %>" class="glass-panel premium-card tracked-node-card" style="padding: 1.25rem;">
                        <div class="mono text-cyan pulse-ring" style="font-size: 0.5rem; margin-bottom: 0.5rem; letter-spacing: 1px; display: inline-block;">LINK_ACTIVE</div>
                        <div class="text-white mono node-name"><%= dao.name %></div>
                        <div class="text-muted mono" style="font-size: 0.5rem; letter-spacing: 1px; margin-top: 0.5rem;">[MONITOR_NODE]</div>
                    </a>
                <% }) %>
            </div>
        </section>
    <% } %>
</div>
