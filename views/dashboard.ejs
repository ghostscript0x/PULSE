<div class="container" style="padding-top: 4rem;">
    <!-- DASHBOARD HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 4rem;">
        <div class="section-label" data-aos="fade-right">Ecosystem Overview</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: 3.5rem; line-height: 1;">DASHBOARD<span class="text-cyan">.</span></h1>
                <p class="text-soft" style="margin-top: 1rem;">Real-time health telemetry across the entire Zero Authority network.</p>
            </div>
            <div class="mono text-cyan" style="font-size: 0.7rem; border: 1px solid var(--glass-border); padding: 0.5rem 1rem; border-radius: 4px; background: rgba(0,212,255,0.02);">
                NETWORK_STATUS: <span class="text-healthy">OPERATIONAL</span>
            </div>
        </div>
    </section>

    <!-- GLOBAL METRICS -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="100">
            <div class="vital-label">Ecosystem Health</div>
            <div class="vital-value text-healthy"><%= stats.healthScore %></div>
            <div class="vital-delta text-healthy mono">↑ +2.1 PTS THIS WEEK</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="200">
            <div class="vital-label">Active Contributors</div>
            <div class="vital-value"><%= (stats.activeContributors || 0).toLocaleString() %></div>
            <div class="vital-delta text-cyan mono">LIVE_NETWORK_NODES</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="300">
            <div class="vital-label">Avg. Completion Rate</div>
            <div class="vital-value"><%= stats.completionRate || 0 %>%</div>
            <div class="vital-delta text-healthy mono">OPTIMIZED_VELOCITY</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 350px 1fr; gap: 2rem;">
        <!-- LEFT: ECOSYSTEM VITALITY -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <section class="glass-panel" style="text-align: center; padding: 3rem 2rem;" data-aos="fade-right">
                <span class="section-label" style="margin-bottom: 2rem;">Network Vitality</span>
                <div class="gauge-container" style="width: 220px; height: 220px;">
                    <svg class="gauge-svg" width="220" height="220" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="6" />
                        <circle cx="50" cy="50" r="45" fill="none" stroke="url(#dashGrad)" stroke-width="6" 
                            stroke-dasharray="283" stroke-dashoffset="<%= 283 - (283 * stats.healthScore / 100) %>" 
                            stroke-linecap="round" />
                        <defs>
                            <linearGradient id="dashGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="var(--accent-cyan)" />
                                <stop offset="100%" stop-color="var(--accent-green)" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="gauge-center">
                        <div class="gauge-number" style="font-size: 3.5rem;"><%= stats.healthScore %></div>
                    </div>
                </div>
                <div class="mono text-soft" style="font-size: 0.7rem; margin-top: 2rem;">THRIVING</div>
            </section>

            <a href="/intelligence" class="btn-cyan-solid" style="padding: 1.5rem; text-align: center; text-decoration: none; display: block;">
                INITIALIZE SPECIFIC TELEMETRY →
            </a>
        </div>

        <!-- RIGHT: NEURAL SYNTHESIS & RECENT ACTIVITY -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <section class="glass-panel" style="min-height: 250px;" data-aos="fade-up">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                    <span class="section-label" style="margin: 0;">Ecosystem Synthesis</span>
                    <div class="text-healthy mono" style="font-size: 0.65rem; border: 1px solid var(--accent-green); padding: 0.3rem 0.6rem; border-radius: 2px;">
                        AI_STRATEGIC_LAYER
                    </div>
                </div>
                
                <div style="border-left: 2px solid var(--accent-cyan); padding-left: 1.5rem;">
                    <p class="text-soft" style="font-size: 0.95rem; line-height: 1.8;">
                        The Zero Authority network is currently showing <span class="text-white">High Momentum</span>. Contributor retention has stabilized at 74% while bounty velocity across the Stacks ecosystem has increased by 12% in the last 24 hours. No critical burnout risks detected at the ecosystem level.
                    </p>
                </div>
            </section>

            <section class="glass-panel" data-aos="fade-up" data-aos-delay="200">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                    <span class="section-label" style="margin: 0;">Global Activity Feed</span>
                    <span class="text-healthy mono" style="font-size: 0.6rem;">[LIVE_STREAM]</span>
                </div>
                
                <div class="mock-browser" style="height: auto; border-radius: 4px;">
                    <div class="mock-main" style="background: #010409; padding: 0;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--glass-border);">
                                    <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">EVENT_TYPE</th>
                                    <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">NODE_SOURCE</th>
                                    <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">STATUS</th>
                                </tr>
                            </thead>
                            <tbody class="mono" style="font-size: 0.75rem;">
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                    <td style="padding: 1rem;">NETWORK_SYNC</td>
                                    <td style="padding: 1rem; color: var(--accent-cyan);">STACKS_MAINNET</td>
                                    <td style="padding: 1rem;" class="text-healthy">VERIFIED</td>
                                </tr>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                    <td style="padding: 1rem;">REPUTATION_MINT</td>
                                    <td style="padding: 1rem; color: var(--accent-cyan);">DAO_NODE_0x2...</td>
                                    <td style="padding: 1rem;" class="text-healthy">COMPLETED</td>
                                </tr>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                    <td style="padding: 1rem;">BOUNTY_PUBLISHED</td>
                                    <td style="padding: 1rem; color: var(--accent-cyan);">ARKADIKO_PROTOCOL</td>
                                    <td style="padding: 1rem;" class="text-healthy">BROADCASTED</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
