<div class="container" style="min-height: calc(100vh - 100px); display: flex; align-items: center; justify-content: center; padding: 4rem 0;">
    <div class="hero-aura" style="background: radial-gradient(circle, rgba(0, 245, 255, 0.03) 0%, transparent 70%);"></div>
    
    <div style="width: 100%; max-width: 450px;" data-aos="fade-up">
        <section class="glass-panel" style="padding: 3.5rem 3rem; border-top: 2px solid var(--accent-cyan);">
            <div class="section-label" style="text-align: center; margin-bottom: 2rem;">Authentication Required</div>
            <h2 style="font-family: var(--font-display); font-size: 2.5rem; text-align: center; margin-bottom: 2.5rem;">INITIALIZE SESSION<span class="text-cyan">.</span></h2>

            <% if(error != '') { %>
                <div class="glass-panel" style="border-color: var(--status-critical); padding: 1rem; margin-bottom: 2rem; background: rgba(255,59,59,0.03);">
                    <div class="text-critical mono" style="font-size: 0.75rem; text-align: center;">[ERROR] <%= error %></div>
                </div>
            <% } %>

            <% if(success_msg != '') { %>
                <div class="glass-panel" style="border-color: var(--status-healthy); padding: 1rem; margin-bottom: 2rem; background: rgba(0,255,136,0.03);">
                    <div class="text-healthy mono" style="font-size: 0.75rem; text-align: center;">[OK] <%= success_msg %></div>
                </div>
            <% } %>

            <form action="/auth/login" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <label class="text-muted mono" style="font-size: 0.65rem; letter-spacing: 2px;">NODE_USERNAME</label>
                    <input type="text" name="username" required 
                        style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 1rem; color: white; border-radius: 4px; outline: none; font-family: var(--font-mono); font-size: 0.9rem;">
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <label class="text-muted mono" style="font-size: 0.65rem; letter-spacing: 2px;">ACCESS_KEY</label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input type="password" name="password" id="password" required 
                            style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 1rem; color: white; border-radius: 4px; outline: none; font-family: var(--font-mono); font-size: 0.9rem;">
                        <button type="button" class="password-toggle" data-target="password" style="position: absolute; right: 1rem; background: transparent; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-cyan-solid" style="width: 100%; margin-top: 1rem; border: none; cursor: pointer;">AUTHENTICATE_NODE</button>
            </form>

            <div style="margin-top: 2.5rem; text-align: center;">
                <a href="/auth/register" class="text-soft mono" style="font-size: 0.7rem; text-decoration: none; border-bottom: 1px solid transparent; transition: 0.3s;" onmouseover="this.style.borderColor='var(--accent-cyan)'" onmouseout="this.style.borderColor='transparent'">CREATE_NEW_ACCESS_NODE_REGISTRY</a>
            </div>
        </section>
    </div>
</div>
