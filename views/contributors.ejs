<div class="container" style="padding-top: 4rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 4rem;">
        <div class="section-label" data-aos="fade-right">Network Registry</div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 style="font-family: var(--font-display); font-size: 3.5rem; line-height: 1;">CONTRIBUTORS<span class="text-cyan">.</span></h1>
                <p class="text-soft" style="margin-top: 1rem;">Real-time reputation telemetry and engagement tracking for your community.</p>
            </div>
            
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 1rem;">
                <!-- NODE SELECTOR -->
                <div style="display: flex; gap: 1rem; align-items: center;">
                    <div class="mono text-muted" style="font-size: 0.6rem;">SWITCH_NODE:</div>
                    <select onchange="handleNodeSwitch(this.value)" style="background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-cyan); padding: 0.5rem 1rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.7rem; outline: none; cursor: pointer;">
                        <% if (followedDaos && followedDaos.length > 0) { %>
                            <% followedDaos.forEach(dao => { %>
                                <option value="<%= dao.daoId %>" <%= activeDao === dao.daoId ? 'selected' : '' %>><%= dao.name %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="">NO_NODES_FOUND</option>
                        <% } %>
                        <option value="DISCOVER_ACTION">+ DISCOVER_NEW</option>
                    </select>
                </div>

                <script>
                    function handleNodeSwitch(val) {
                        if (val === 'DISCOVER_ACTION') {
                            window.location.href = '/command-center';
                        } else if (val) {
                            window.location.href = '/contributors/' + val;
                        }
                    }
                </script>

                <% if (activeDao) { %>
                    <div class="mono text-cyan" style="font-size: 0.7rem; border: 1px solid var(--glass-border); padding: 0.5rem 1rem; border-radius: 4px; background: rgba(0,212,255,0.02);">
                        ACTIVE_NODE: <%= activeDao %>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <%
        const avgRep = contributors.length > 0 ? Math.round(contributors.reduce((a,c) => a + (c.reputationScore||0), 0) / contributors.length) : 0;
        const activeContributors = contributors.filter(c => {
            const lastActive = c.lastActive ? new Date(c.lastActive) : null;
            const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
            return lastActive && lastActive > weekAgo;
        }).length;
        const activePercent = contributors.length > 0 ? Math.round((activeContributors / contributors.length) * 100) : 0;
    %>

    <!-- STATS -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="100">
            <div class="vital-label">Total Registered</div>
            <div class="vital-value"><%= contributors.length %></div>
            <div class="vital-delta text-healthy mono">↑ ACTIVE_NODES</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="200">
            <div class="vital-label">Avg Reputation</div>
            <div class="vital-value text-cyan"><%= avgRep %></div>
            <div class="vital-delta text-cyan mono">MEAN_SCORE</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="300">
            <div class="vital-label">Rising Stars</div>
            <div class="vital-value"><%= contributors.filter(c => (c.reputationScore || 0) > 800).length %></div>
            <div class="vital-delta text-healthy mono">THRESHOLD_MET</div>
        </div>
        <div class="vital-panel" style="background: var(--bg-card); border: 1px solid var(--glass-border); padding: 1.5rem;" data-aos="fade-up" data-aos-delay="400">
            <div class="vital-label">Weekly Activity</div>
            <div class="vital-value"><%= activePercent %>%</div>
            <div class="vital-delta <%= activePercent > 50 ? 'text-healthy' : 'text-warning' %> mono">
                <%= activePercent > 50 ? 'OPTIMIZED' : 'DORMANT' %>
            </div>
        </div>
    </div>

    <!-- LEADERBOARD & TABLE -->
    <div class="responsive-grid" style="grid-template-columns: 1fr; gap: 2rem;">
        <div>
            <section class="glass-panel" style="padding: 0;">
                <div class="table-wrapper">
                    <table style="min-width: 600px;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--glass-border);">
                                <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">CONTRIBUTOR</th>
                                <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">REPUTATION</th>
                                <th class="mono" style="padding: 1rem; text-align: left; font-size: 0.6rem; color: var(--text-muted);">STATUS</th>
                            </tr>
                        </thead>
                        <tbody class="mono" style="font-size: 0.75rem;">
                            <% if (contributors.length === 0) { %>
                                <tr>
                                    <td colspan="3" style="padding: 4rem; text-align: center; color: var(--text-muted);">AWAITING_TELEMETRY</td>
                                </tr>
                            <% } else { %>
                                <% contributors.forEach(c => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                        <td style="padding: 1rem;">
                                            <div class="text-cyan" style="font-weight: 600;"><%= (c.stxAddress || 'UNKNOWN').substring(0, 8) %>...<%= (c.stxAddress || '').slice(-4) %></div>
                                        </td>
                                        <td style="padding: 1rem;">
                                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                <span style="font-weight: 700; width: 35px;"><%= c.reputationScore !== undefined ? c.reputationScore : '—' %></span>
                                                <% if (c.reputationScore !== undefined) { %>
                                                <div style="width: 60px; height: 2px; background: rgba(255,255,255,0.05);">
                                                    <div style="width: <%= Math.min(100, c.reputationScore / 10) %>%; height: 100%; background: var(--accent-cyan);"></div>
                                                </div>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td style="padding: 1rem;">
                                            <% if (c.lastActive) { %>
                                                <% const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000); %>
                                                <% const isActive = new Date(c.lastActive) > weekAgo; %>
                                                <span class="<%= isActive ? 'text-healthy' : 'text-warning' %>" style="font-size: 0.55rem; border: 1px solid currentColor; padding: 0.2rem 0.4rem; border-radius: 2px;"><%= isActive ? 'ACTIVE' : 'DORMANT' %></span>
                                            <% } else { %>
                                                <span class="text-muted" style="font-size: 0.55rem; border: 1px solid currentColor; padding: 0.2rem 0.4rem; border-radius: 2px;">UNKNOWN</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <section class="glass-panel" style="padding: 2rem; text-align: center;">
                <span class="section-label" style="margin-bottom: 1.5rem;">Top Contributor</span>
                <% const top = contributors.sort((a,b) => (b.reputationScore||0) - (a.reputationScore||0))[0]; %>
                <% if (top) { %>
                    <div class="text-cyan mono" style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;">#1</div>
                    <div class="mono" style="font-size: 0.8rem; margin-bottom: 1rem; opacity: 0.7; word-break: break-all;">
                        <%= (top.stxAddress || 'UNKNOWN').substring(0, 10) %>...
                    </div>
                    <div style="display: inline-block; background: rgba(0,255,136,0.1); color: var(--accent-green); border: 1px solid var(--accent-green); padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.7rem; font-family: var(--font-mono);">
                        <%= top.reputationScore !== undefined ? top.reputationScore + ' REPUTATION' : '—' %>
                    </div>
                <% } else { %>
                    <div class="text-muted mono">AWAITING_LEADER</div>
                <% } %>
            </section>

            <section class="glass-panel" style="padding: 2rem;">
                <span class="section-label" style="margin-bottom: 1.5rem;">System Actions</span>
                <div style="display: grid; grid-template-columns: 1fr; gap: 0.75rem;">
                    <a href="/dashboard" class="btn-cyan-solid">Sync Node</a>
                    <a href="/about" class="btn-cyan-solid" style="background: transparent; border: 1px solid var(--glass-border); color: white;">Docs</a>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
    .table-row-hover:hover { background: rgba(0, 245, 255, 0.02) !important; }
</style>
