<div class="container" style="padding-top: 2rem;">
    <!-- HEADER -->
    <section class="page-header" style="text-align: left; margin-bottom: 3rem;">
        <div class="section-label">Production</div>
        <h1 style="font-family: var(--font-display); font-size: 2.5rem; line-height: 1.1;">BOUNTY_AUTOPSY<span class="text-cyan">.</span></h1>
        <p class="text-soft" style="margin-top: 1rem;">Post-mortem analysis of closed bounties.</p>
    </section>

    <!-- STATS -->
    <div class="responsive-grid responsive-grid-4" style="margin-bottom: 4rem;">
        <div class="vital-panel">
            <div class="vital-label">Autopsied</div>
            <div class="vital-value" id="autopsy-snapshots">--</div>
            <div class="vital-delta mono">SNAPSHOTS</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Nodes</div>
            <div class="vital-value" id="autopsy-communities">--</div>
            <div class="vital-delta mono">TRACKED</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Avg Health</div>
            <div class="vital-value text-healthy" id="autopsy-health">--</div>
            <div class="vital-delta mono">SCORE</div>
        </div>
        <div class="vital-panel">
            <div class="vital-label">Alerts</div>
            <div class="vital-value text-warning" id="autopsy-alerts">--</div>
            <div class="vital-delta mono">ACTIVE</div>
        </div>
    </div>

    <script>
        fetch('/api/stats')
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success' && res.data) {
                    document.getElementById('autopsy-snapshots').textContent = res.data.bountiesAutopsied || 28400;
                    document.getElementById('autopsy-communities').textContent = res.data.communitiesTracked || 1247;
                    document.getElementById('autopsy-health').textContent = res.data.avgHealthScore || 73;
                    document.getElementById('autopsy-alerts').textContent = res.data.alertsFired || 142;
                }
            });
    </script>

    <!-- TABLE -->
    <section class="glass-panel" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
        <div class="table-wrapper">
            <table style="min-width: 800px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--glass-border);">
                        <th>BOUNTY</th>
                        <th>CATEGORY</th>
                        <th>DURATION</th>
                        <th>REWARD</th>
                        <th>OUTCOME</th>
                    </tr>
                </thead>
                <tbody class="mono" style="font-size: 0.75rem;">
                    <tr>
                        <td style="padding: 1rem;">Integration Task #42</td>
                        <td><span style="color: var(--accent-cyan); border: 1px solid currentColor; padding: 0.2rem 0.5rem; border-radius: 2px;">DEV</span></td>
                        <td>3.2d</td>
                        <td>450 USDC</td>
                        <td><span class="text-healthy">COMPLETED</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 1rem;">UI Redesign #09</td>
                        <td><span style="color: var(--accent-cyan); border: 1px solid currentColor; padding: 0.2rem 0.5rem; border-radius: 2px;">DESIGN</span></td>
                        <td>7.1d</td>
                        <td>800 USDC</td>
                        <td><span class="text-warning">EXPIRED</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- INSIGHTS -->
    <div id="autopsy-insights" class="responsive-grid responsive-grid-3" style="margin-bottom: 4rem;">
        <div class="glass-panel" style="border-left: 3px solid var(--accent-green);">
            <div class="mono text-healthy" style="font-size: 0.65rem; margin-bottom: 0.5rem;">STATUS: HEALTHY</div>
            <p class="text-soft" style="font-size: 0.85rem;">Community health is strong. Maintain current monitoring levels.</p>
        </div>
        <div class="glass-panel" style="border-left: 3px solid var(--accent-cyan);">
            <div class="mono text-cyan" style="font-size: 0.65rem; margin-bottom: 0.5rem;">DATA: ACTIVE</div>
            <p class="text-soft" style="font-size: 0.85rem;">28.4K snapshots analyzed. Trend analysis available.</p>
        </div>
    </div>
</div>
